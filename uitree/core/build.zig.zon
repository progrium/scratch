.{
    .name = .uitcore,
    .version = "0.0.0",
    .fingerprint = 0x4a5c623ca7b9c815, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // hyper9, for h9.Machine (the app sandbox) and dotl/wire.zig (9P
        // framing). A submodule of this repo.
        .h9 = .{ .path = "../third_party/hyper9", .lazy = true },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "include", "types", "tests" },
}
