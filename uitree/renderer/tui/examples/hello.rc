#!/bin/rc
# hello.rc: the Greeter. Type a name, press Greet or Enter.
#
#	uitree-tui -t Greeter rc hello.rc
#
# uitreefs/examples/rc/hello.rc in the draft 0.2 spelling: dashed style
# words, `primary` as a bare word, window-relative event paths. The
# subtree is built with `new` lines instead of the `tree` file, which the
# spike core doesn't serve yet (W3).
. ./lib.rc
m=$ui/win/main

echo 'set . title=Greeter size=360,170 pos=center resizable=off : v-flex size-full p=20 gap=12 bg=background
new div row tag=greet : h-flex gap=8
new input row/name placeholder=''Your name'' : flex-1
new button row/go label=Greet primary
new text out text=''Who are you?'' : text-lg text-color=muted-foreground' >$m/ctl
echo row/name >$m/focus

{ while(ev=`{read}){
	switch($ev(1)^:^$ev(2)){
	case click:greet submit:greet
		n=`{cat $m/row/name/value}
		if(~ $#n 0) n=stranger
		echo 'Hello, '^$"n^'!' >$m/out/text
		echo 'set out : text-lg font-semibold text-color=foreground' >$m/ctl
	}
} } <$ui/events
