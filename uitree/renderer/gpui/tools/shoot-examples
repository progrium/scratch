#!/bin/sh
# shoot-examples: run every 0.2 example from the uitree binary under Xvfb,
# with the app in h9, and screenshot each window once its tree is built.
#
#	tools/shoot-examples [OUTDIR] [NAME...]
#
# The examples are tests/conformance/examples/list (run-examples checks
# what they build; this checks they draw). Needs a release build (cargo
# build --release -p uitree), Xvfb, ImageMagick's import, and $H9ROOT
# naming a 9front root (README.md); the Linux examples need $LINUXROOT,
# the Alpine tree ../../tools/linuxroot makes, and are skipped without
# it, and the Go ones need go. OUTDIR defaults to
# examples/screenshots/ci. GPUI needs Vulkan: on a machine with no GPU
# install Mesa's lavapipe (mesa-vulkan-drivers) or point VK_ICD_FILENAMES
# at its lvp_icd.json. SHOOT_WAIT is the seconds to wait before the shot
# (default 8; Linux clients get twice that). Exit 1 if an example exits
# before it is shot or a screenshot is blank.
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
bin=$here/target/release/uitree
ex=$here/../../tests/conformance/examples
out=${1:-$here/examples/screenshots/ci}
[ $# -gt 0 ] && shift
mkdir -p "$out"
out=$(cd "$out" && pwd)
[ -x "$bin" ] || { echo "shoot-examples: no $bin (cargo build --release -p uitree)" >&2; exit 2; }
: "${H9ROOT:?shoot-examples: set H9ROOT to a 9front root}"
linux=${LINUXROOT:-}
wait_secs=${SHOOT_WAIT:-8}

list() { grep -v '^#' "$ex/list" | grep .; }
want="$*"

disp=:${DISPLAY_NUM:-91}
Xvfb "$disp" -screen 0 1280x800x24 >/dev/null 2>&1 &
xvfb=$!
trap 'kill $xvfb 2>/dev/null' EXIT INT TERM
sleep 1

fail=0
list | {
while IFS='|' read -r name dir title view flags cmd; do
	if [ -n "$want" ] && ! echo " $want " | grep -q " $name "; then continue; fi
	log=$out/$name.log
	secs=$wait_secs
	case ",$flags," in *,go,*)
		command -v go >/dev/null || { echo "skip $name (no go)"; continue; }
		(cd "$ex/$dir" && GOOS=plan9 GOARCH=amd64 CGO_ENABLED=0 go build -o "$(basename "$dir")" .) || { echo "FAIL $name (go build)"; fail=1; continue; }
	esac
	if [ "$view" = linux ]; then
		[ -n "$linux" ] || { echo "skip $name (no LINUXROOT)"; continue; }
		secs=$((wait_secs * 2))
		(cd "$ex/$dir" && DISPLAY=$disp exec "$bin" -k -t "$title" -d "$linux:#L" sh -c "$cmd") >"$log" 2>&1 &
	else
		# flag linux: a Plan 9 command that starts Linux programs from #L.
		set --
		case ",$flags," in *,linux,*)
			[ -n "$linux" ] || { echo "skip $name (no LINUXROOT)"; continue; }
			secs=$((wait_secs * 2))
			# The machine's root view is then Linux: rc is /9/bin/rc,
			# and $ui is set for the Plan 9 view.
			set -- -d "$linux:#L" -e ui=/mnt/ui
			cmd=$(echo "$cmd" | sed 's|^rc |/9/bin/rc |')
		esac
		eval "set -- \"\$@\" $cmd"
		(cd "$ex/$dir" && DISPLAY=$disp exec "$bin" -k -t "$title" "$@") >"$log" 2>&1 &
	fi
	pid=$!
	sleep "$secs"
	if ! kill -0 $pid 2>/dev/null; then
		wait $pid; st=$?
		echo "FAIL $name: exited ($st) before the screenshot (see $log)"
		sed 's/^/	/' "$log" | tail -20
		fail=1
		continue
	fi
	DISPLAY=$disp import -window root "$out/$name.png"
	kill $pid 2>/dev/null; wait $pid 2>/dev/null
	# A blank frame has one colour.
	colors=$(convert "$out/$name.png" -format '%k' info: 2>/dev/null || echo 0)
	if [ "${colors:-0}" -le 1 ]; then
		echo "FAIL $name: blank screenshot"
		fail=1
	else
		echo "shot $name ($colors colours) $out/$name.png"
	fi
done
exit $fail
}
