#!/bin/rc
# 03-create: core.md § Creating nodes. mkdir, new and a tree document make
# the same tree; delete and rm -r remove a node; a name is free again once
# its node is gone.
# needs: W1 W2 W3 W4
. ./lib.rc
mainwin
r=$k/win/main

w $r/ctl new div one
w $r/ctl new div two
w $r/ctl new div three

echo '# 1. mkdir and files'
mkdir $r/one/hi
w $r/one/hi/type text
w $r/one/hi/text Hello
w $r/one/hi/style font-bold
w $r/one/hi/tag greet
cat $r/one/tree

echo '# 2. new'
w $r/two/ctl new text hi 'text=Hello' 'tag=greet' : font-bold
cat $r/two/tree

echo '# 3. a tree document'
echo 'div three
  text hi  text=Hello  tag=greet  : font-bold' >$r/three/tree
cat $r/three/tree

echo '# 4. tree PATH <<END on a ctl'
w $r/ctl new div four
w $r/ctl 'tree four <<END
div four
  text hi  text=Hello  tag=greet  : font-bold
END'
cat $r/four/tree

echo '# mkdir appends to order, as new does'
mkdir $r/five
val $r/order

echo '# new needs the parent to exist'
w $r/ctl new text nope/x
echo '# a name in use'
w $r/ctl new div one
w $r/ctl new text one

echo '# delete'
w $r/ctl delete two
exists $r/two
val $r/order
echo '# delete of a name that is not there'
w $r/ctl delete two

echo '# rm -r'
rm -r $r/one
exists $r/one $r/one/hi
val $r/order

echo '# the name is free again'
w $r/ctl new text one 'text=back'
val $r/one/type $r/one/text
