# core.md's clickable card
ok
ok
ok
div list
  div card1  tag=open:42  on=click  : v-flex gap=4 p=12 rounded-md border-1 border-color=border hover:bg=accent
    text title  text='Quarterly report'  : text-sm font-semibold
# a click carries the tag as its key, and an untagged node takes its nearest tagged ancestor's
resync - -
click open:42 list/card1 win=main
click open:42 list/card1/title win=main
click - list win=main
exit=0
