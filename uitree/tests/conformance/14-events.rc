#!/bin/rc
# 14-events: core.md § Events, § Subscriptions and § Two kinds of event.
# The three grains, resync, the head, tag routing, echoes, coalescing,
# order, seq, quoting, error events, gone and end of file.
# needs: W1 W2 W3 W4
. ./lib.rc
mainwin
wq $k/ctl window other
wn=$k/win/main
r=$wn
wq $r/ctl 'new div a tag=open:42 on=click
new div b on=click
new div a/c on=click'

echo '# each open is a subscription that starts with resync - - seq=N'
{ sed 1q <[0=3] | sed 's/[0-9]+$/N/' } <[3]$k/events

echo '# grains: a node''s events hold it and its descendants, a window''s, the app''s'
{
	{
		{
			inj event click 'win=main' 'node=a'
			inj event click 'win=main' 'node=a/c'
			inj event click 'win=main' 'node=b'
			inj event click 'win=other' 'node=.'
			echo '-- node a'
			evs 'win=main' 'node=a'
		} <[3]$r/a/events
		echo '-- window main'
		evs 'win=main'
	} <[3]$wn/events
	echo '-- app'
	evs
} <[3]$k/events

echo '# two subscriptions to one file see the same lines'
{
	{
		inj event click 'win=main' 'node=b'
		evs 'win=main'
	} <[3]$wn/events
	echo '-- second'
	evs 'win=main'
} <[3]$wn/events

echo '# the key is the tag file at the time of the event'
{
	inj event click 'win=main' 'node=a'
	wq $r/a/tag open:43
	inj event click 'win=main' 'node=a'
	evs 'win=main'
} <[3]$wn/events

echo '# a state event replaces a queued one with the same name and node, and moves to the back'
{
	inj event hover 'win=main' 'node=a' 'value=on'
	inj event click 'win=main' 'node=b'
	inj event hover 'win=main' 'node=a' 'value=off'
	inj event hover 'win=main' 'node=b' 'value=on'
	evs 'win=main'
} <[3]$wn/events

echo '# never a change after the submit that came from it'
wq $r/ctl new div in
{
	inj event change 'win=main' 'node=in'
	inj event submit 'win=main' 'node=in'
	inj event change 'win=main' 'node=in'
	evs 'win=main'
} <[3]$wn/events

echo '# action events are never coalesced'
{
	inj event click 'win=main' 'node=b'
	inj event click 'win=main' 'node=b'
	inj event click 'win=main' 'node=b'
	evs 'win=main'
} <[3]$wn/events

echo '# one seq counter: increasing, and the same event has the same seq in every file'
{
	{
		inj event click 'win=main' 'node=a'
		inj event click 'win=other' 'node=.'
		inj event click 'win=main' 'node=b'
		evraw >/tmp/ev
	} <[3]$k/events
	evraw 'win=main' >/tmp/ev2
} <[3]$wn/events
grep -v '^resync' /tmp/ev | sed -n 's/.* seq=([0-9]+).*/\1/p' >/tmp/seqs
sort -n /tmp/seqs >/tmp/sorted
cmp -s /tmp/sorted /tmp/seqs && echo increasing
sort -u /tmp/seqs | count
grep '^click .* win=main' /tmp/ev >/tmp/a1
grep '^click ' /tmp/ev2 >/tmp/a2
cmp -s /tmp/a1 /tmp/a2 && echo same

echo '# seq= comes last'
grep -v '^resync' /tmp/ev | grep -vc ' seq=[0-9]+$'

echo '# values with blanks are quoted, once'
{
	inj event action 'win=main' 'key=save' 'label=''Save all''' 'note=''it''''s'''
	evs 'win=main'
} <[3]$wn/events

echo '# a failed write is an error event with its code'
{
	echo 'set zz text=x' >$r/ctl >[2]/dev/null
	echo wobble >$r/a/ctl >[2]/dev/null
	evs 'win=main'
} <[3]$wn/events

echo '# removing a node ends its stream with gone, then end of file'
{
	wq $r/ctl delete b
	cat <[0=3] | evnorm
	echo eof
} <[3]$r/b/events
echo '# destroying a window ends its stream the same way'
{
	wq $k/win/other/ctl destroy
	cat <[0=3] | evnorm
	echo eof
} <[3]$k/win/other/events
