-- window main planets.csv
div root  : v-flex size-full bg=background
  div top  : h-flex items-center gap=8 p=12 border-b-1 border-color=border
    text name  text=planets.csv  : font-semibold flex-1
    input q  cleanable  placeholder=Filter…  tag=filter  : w=260
      icon prefix  name=search
  table t  stripe  sortable  sorted  resizable  selectable=row  tag=table  columns=<<END  rows=<<END2  : flex-1
c1	Planet	180	sort
c2	Type	180	sort
c3	Mass (Earth=1)	156	sort	align=right
c4	Radius (km)	132	sort	align=right
c5	Moons	100	sort	align=right
c6	Day (hours)	132	sort	align=right
c7	Year (days)	132	sort	align=right
END
1	Mercury	Terrestrial	0.055	2440	0	4222.6	88
2	Venus	Terrestrial	0.815	6052	0	2802	224.7
3	Earth	Terrestrial	1	6371	1	24	365.2
4	Mars	Terrestrial	0.107	3390	2	24.7	687
5	Jupiter	Gas giant	317.8	69911	95	9.9	4331
6	Saturn	Gas giant	95.2	58232	146	10.7	10747
7	Uranus	Ice giant	14.5	25362	28	17.2	30589
8	Neptune	Ice giant	17.1	24622	16	16.1	59800
9	Pluto	Dwarf	0.0022	1188	5	153.3	90560
10	Ceres	Dwarf	0.00016	470	0	9.1	1682
END2
  status-bar st
    text left  text='10 rows'  : text-xs text-color=muted-foreground
-- overlay main/card
sheet card  size=380
  description-list facts  bordered  columns=1
-- menu/bar
-- keys
cmd-f find
escape clear
-- stderr
