#!/bin/rc
# Ported from uitreefs/examples to spec draft 0.2 (dashed names, bare
# variant words, menu/bar) for the conformance suite's tree-building check.
# counter.rc: the smallest stateful app, built only from raw elements.
#
#	uitree -t Counter rc counter.rc
#
# Shows: the element tier (div, text) with style words after a lone :,
# hover: and active: state styles that never reach the client, on=click on
# a plain div, key bindings and menu items that share the buttons' keys,
# so one switch on $ev(2) handles click, key and menu alike.   Needs: M2
. ./lib.rc
m=$ui/win/main

# One style for both round buttons.
b='size=40 flex items-center justify-center rounded-full border-1 border-color=border text-xl cursor-pointer hover:bg=accent active:bg=muted'

echo 'set . title=Counter size=300,180 pos=center : h-flex size-full items-center justify-center gap=20 bg=background
new div dec tag=dec on=click : '$b'
new text n text=0 : text-3xl font-semibold w=72 text-center
new div inc tag=inc on=click : '$b'
new text dec/t text=−
new text inc/t text=+' >$m/ctl

echo '=      inc
-      dec
0      reset' >$ui/keys
echo 'item inc    label=Increment  key==
item dec    label=Decrement  key=-
sep
item reset  label=Reset      key=0' >$ui/menu/Counter
echo Counter >$ui/menu/bar

n=0
cat $ui/events | while(ev=`{read}){
	o=$n
	switch($ev(1)^:^$ev(2)){
	case click:inc action:inc
		n=`{add $n 1}
	case click:dec action:dec
		n=`{add $n -1}
	case action:reset
		n=0
	}
	if(! ~ $n $o) echo 'set n text='$n >$m/ctl
}
