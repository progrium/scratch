#!/bin/rc
# settings.rc: a settings window in the style of GPUI Kit's gallery:
# a sidebar of pages, and pages of grouped controls. Appearance changes
# apply live, by writing theme/mode, theme/name and theme tokens.
#
#	uitree -t Settings rc settings.rc
#
# Shows: sidebar navigation, pages kept alive and switched with order (so
# their controls keep their values), switch, select, slider, radio-group,
# number-input, a table of shortcuts read from the key bindings, a theme
# picker filled from the host's theme/names, theme tokens changed live,
# settings saved as name=value lines.
. ./lib.rc

# Saved settings. /tmp, so a run leaves nothing in the directory it ran in.
db=/tmp/settings.txt
touch $db

m=$ui/win/main
echo 'set . title=Settings size=820,560 min=640,420 pos=center' >$m/ctl

cat >$m/tree <<'END'
div root  : h-flex items-stretch size-full bg=background
  sidebar nav  collapsible=off  : w=220
    sidebar-group g  label=Settings
      sidebar-item general  active  label=General  icon=settings  tag=page:general
      sidebar-item look  label=Appearance  icon=palette  tag=page:look
      sidebar-item account  label=Account  icon=user  tag=page:account
      sidebar-item keys  label=Shortcuts  icon=keyboard  tag=page:keys
  scroll page  : flex-1 overflow-y-scroll p=32
    div general  : v-flex gap=24 max-w=560
      text h  text=General  : text-xl font-semibold
      group-box startup  title=Startup
        div rows  : v-flex gap=12
          switch login  label='Open at login'  tag=set:login
          switch restore  label='Reopen windows from last time'  value=on  tag=set:restore
          switch updates  label='Check for updates automatically'  value=on  tag=set:updates
      group-box lang  title=Language
        form f  labels=side  label-width=140
          field l  label='Interface language'
            select in  value=en  tag=set:lang
          field n  label='Recent items'  description='How many files Open Recent lists.'
            number-input in  value=10  min=0  max=50  tag=set:recent
    div look  : v-flex gap=24 max-w=560
      text h  text=Appearance  : text-xl font-semibold
      group-box theme  title=Theme
        form f  labels=side  label-width=140
          field mode  label=Mode
            radio-group in  value=light  dir=row  tag=set:mode
          field name  label=Theme
            select in  searchable  value=Default  tag=set:theme
          field radius  label='Corner radius'
            slider in  min=0  max=16  step=1  value=6  tag=set:radius
          field size  label='Font size'
            slider in  min=11  max=18  step=1  value=14  tag=set:font-size
      alert note  variant=info  title='Changes apply right away'  text='Every style that names a theme token re-resolves on the next frame.'
    div account  : v-flex gap=24 max-w=560
      text h  text=Account  : text-xl font-semibold
      div who  : h-flex items-center gap=12
        avatar a  name='Ada Lovelace'  lg
        div n  : v-flex
          text name  text='Ada Lovelace'  : font-semibold
          text mail  text=ada@example.com  : text-sm text-color=muted-foreground
      form f  labels=top
        field name  label='Display name'
          input in  value='Ada Lovelace'  tag=set:name
        field mail  label=Email
          input in  value=ada@example.com  tag=set:email
      div danger  : h-flex gap=8
        button out  label='Sign out'  tag=signout  outline
        button del  label='Delete account'  tag=delete  danger ghost
    div keys  : v-flex gap=24 flex-1
      text h  text=Shortcuts  : text-xl font-semibold
      table t  stripe  sortable  sorted  : h=320
END
p=$m/page
echo general >$p/order

# Data files: one row per line, words with the usual quoting, no tabs.
cat >$p/general/lang/f/l/in/items <<'END'
en English
fr Français
de Deutsch
ja 日本語
END
cat >$p/look/theme/f/mode/in/items <<'END'
light Light
dark Dark
END
# The theme picker: the host's theme families, from theme/names (one
# theme per line, `NAME mode=M family=F`). A family follows the Mode
# setting: Catppuccin is Latte in light mode and Frappe in dark.
# Names keep their quoting, so 'macOS Classic' is one word in items too.
awk '/ family=/ { f = $0; sub(/.* family=/, "", f); if(!(f in seen)) { seen[f] = 1; print f, f } }' \
	$ui/theme/names >$p/look/theme/f/name/in/items
cat >$p/keys/t/columns <<'END'
key Shortcut 160 sort
id Action 240 sort
END
cat >$ui/keys <<'END'
cmd-,        settings
cmd-w        close-window
cmd-1        page:general
cmd-2        page:look
cmd-3        page:account
cmd-4        page:keys
END
awk 'NF >= 2 { print NR, $1, $2 }' $ui/keys >$p/keys/t/rows

# Saved settings: name=value lines, applied by the same code as a change.
fn apply {
	n=$1
	shift
	switch($n){
	case mode
		echo $1 >$ui/theme/mode
	case theme
		echo $"* >$ui/theme/name
	case radius
		echo $n $1 >$ui/theme/tokens
	}
}
fn save {
	n=$1
	shift
	grep -v '^'$n'=' $db >/tmp/settings.new
	echo $n^'='^$"* >>/tmp/settings.new
	cat /tmp/settings.new >$db
}
ifs='
' { saved=`{cat $db} }
for(kv in $saved) apply `{echo $kv | sed 's/=/ /'}

cur=general
fn go {
	echo 'set nav/g/'$cur' active=off
set nav/g/'$1' active=on
set page order='$1 >$m/ctl
	cur=$1
}

# Events say what changed; the value file says what it is now, so a value
# with blanks in it ("Tokyo Night") never has to be unquoted here. The
# third word of an event is the node's path, the same path to read from.
cat $ui/events | while(ev=`{read}){
	arg=`{echo $ev(2) | sed 's/^[^:]*://'}
	switch($ev(1)^:^$ev(2)){
	case click:page:* action:page:*
		go $arg
	case click:signout click:delete
		echo 'notify ''Not in this example'' type=info' >$m/ctl
	case change:set:*
		v=`{cat $m/$ev(3)^/value}
		apply $arg $v
		save $arg $v
	}
}
