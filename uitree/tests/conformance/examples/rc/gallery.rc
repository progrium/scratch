#!/bin/rc
# gallery.rc: a recreation of GPUI Kit's component gallery (its "story"
# app): a sidebar of components, and a live story for each one. Every
# event the story sends is shown in the status bar, so this doubles as a
# way to learn what each component reports.
#
#	uitree -t Gallery rc gallery.rc
#
# Shows: most of the catalog; screens as files (each story is a tree
# document in gallery/, written to the same node, so switching stories is
# one write); theme/mode; popover and tooltip with no round trip; dialogs
# and notifications from ctl.
# Needs: M3 (the editor story needs W6d, the chart story W6c)
. ./lib.rc

m=$ui/win/main
echo 'set . title=''GPUI Kit Gallery'' size=1100,720 min=800,520 pos=center' >$m/ctl

cat >$m/tree <<'END'
div root  : h-flex items-stretch size-full bg=background
  sidebar nav  : w=230
    div header  : h-flex items-center gap=8 p=12
      icon logo  name=layout-dashboard  : size=18 text-color=primary
      text name  text='GPUI Kit'  : font-semibold
    sidebar-group basic  label=Basic
      sidebar-item button  active  label=Button  tag=story:button
      sidebar-item badge  label='Badge & Tag'  tag=story:badge
      sidebar-item avatar  label=Avatar  tag=story:avatar
      sidebar-item kbd  label=Kbd  tag=story:kbd
    sidebar-group form  label=Form
      sidebar-item input  label=Input  tag=story:input
      sidebar-item toggles  label='Checkbox & Switch'  tag=story:toggles
      sidebar-item select  label=Select  tag=story:select
      sidebar-item slider  label=Slider  tag=story:slider
      sidebar-item date  label='Date Picker'  tag=story:date
    sidebar-group data  label=Data
      sidebar-item table  label=Table  tag=story:table
      sidebar-item treeview  label=Tree  tag=story:treeview
      sidebar-item progress  label=Progress  tag=story:progress
      sidebar-item chart  label=Chart  tag=story:chart
    sidebar-group overlay  label=Overlay
      sidebar-item dialog  label=Dialog  tag=story:dialog
      sidebar-item popover  label='Popover & Tooltip'  tag=story:popover
      sidebar-item notify  label=Notification  tag=story:notify
    sidebar-group layout  label=Layout
      sidebar-item tabs  label=Tabs  tag=story:tabs
      sidebar-item accordion  label=Accordion  tag=story:accordion
      sidebar-item resizable  label=Resizable  tag=story:resizable
    sidebar-group text  label=Text
      sidebar-item editor  label=Editor  tag=story:editor
      sidebar-item markdown  label=Markdown  tag=story:markdown
  div main  : v-flex flex-1
    div head  : h-flex items-center gap=12 px=24 py=16 border-b-1 border-color=border
      div t  : v-flex flex-1
        text title  : text-xl font-semibold
        text desc  : text-sm text-color=muted-foreground
      switch dark  label=Dark  tag=dark
    scroll story  : flex-1 overflow-y-scroll p=24
    status-bar log
      text left  : text-xs font-family=monospace text-color=muted-foreground truncate
END
S=$m/main/story

# story name: set the heading and write the story's subtree.
# Each story is a directory in gallery/: title (heading and description),
# tree (the subtree document, which starts with the story node itself, so
# one write replaces the whole story), and files to write into the new
# nodes at the same relative paths (data files are plain words, one row
# per line, no tabs).
fn story {
	g=gallery/$1
	sed -n 1p $g/title >$m/main/head/t/title/text
	sed -n 2p $g/title >$m/main/head/t/desc/text
	unanchored
	cat $g/tree >$S/tree
	for(f in `{walk -f $g | sed 's,^'$g'/,,' | grep -v '^(title|tree)$'})
		cat $g/$f >$S/$f
	if(~ $1 popover) anchored
}

# Overlays used by the stories. They are made once; stories only open them.
o=$m/over
echo 'new dialog dlg keyboard title=''Edit profile'' description=''Make changes to your profile here.'' width=420
new alert-dialog del title=''Delete 3 files?'' description=''This cannot be undone.'' confirm=Delete cancel=Keep variant=danger tag=del
new sheet sheet side=right size=360 title=Filters
new input dlg/name placeholder=Name
new div dlg/footer : h-flex justify-end gap=8
new button dlg/footer/cancel label=Cancel tag=dlg:cancel  ghost
new button dlg/footer/save label=Save tag=dlg:save  primary
new checkbox sheet/a label=''Only open''
new checkbox sheet/b label=''Assigned to me''' >$o/ctl

# The popover and hover card are bound to buttons in the popover story, and
# an anchor must name a node that exists, so they live only while that
# story is shown.
fn anchored {
	echo 'new popover pop anchor=main/story/v/p placement=bottom-start trigger=click
new hover-card card anchor=main/story/v/h
new text pop/t text=''A popover, opened by its anchor.'' : p=12
new div card/c : v-flex gap=4 p=12 w=240
new text card/c/n text=@uitreefs : font-semibold
new text card/c/d text=''Files all the way down.'' : text-sm' >$o/ctl
}
fn unanchored {
	for(n in pop card) if(test -d $o/$n) echo delete $n >$o/ctl
}

# active name on|off: mark a sidebar item, whichever group it is in.
fn active {
	for(g in basic form data overlay layout text)
		if(test -d $m/nav/$g/$1) echo 'set nav/'$g'/'$1' active='$2 >$m/ctl
}

cur=button
story button

cat $ui/events | while(ev=`{read}){
	echo $ev >$m/main/log/left/text
	arg=`{echo $ev(2) | sed 's/^[^:]*://'}
	switch($ev(1)^:^$ev(2)){
	case click:story:*
		active $cur off
		active $arg on
		cur=$arg
		story $arg
	case click:open:*
		echo open >$o/$arg/ctl
	case click:dlg:*
		echo close >$o/dlg/ctl
		if(~ $arg save) echo 'notify ''Profile saved'' type=success' >$m/ctl
	case click:toast:*
		echo 'notify ''This is '^$arg^''' type='^$arg >$m/ctl
	case change:dark
		if(~ `{attr value} on) echo dark >$ui/theme/mode
		if not echo light >$ui/theme/mode
	case confirm:*
		echo 'notify ''Deleted'' type=success' >$m/ctl
	}
}
