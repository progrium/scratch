#!/bin/rc
# notes.rc: the design doc's complete client, a notes app. A searchable
# list of notes, a markdown editor, a toolbar, key bindings and a File menu.
# Notes are files in $home/notes.
#
#	uitree -t Notes rc notes.rc
#
# This is DESIGN.md § A complete client, plus a new note being selected
# and deleting asking first. Buttons, keys and menu items share keys
# (save, new, del), so the loop switches on the event's first two words.
# Needs: M3
. ./lib.rc
m=$ui/win/main

n=$home/notes
mkdir -p $n >[2]/dev/null

echo 'set . title=Notes size=900,600 min=600,400' >$m/ctl
cat >$m/tree <<'END'
div root  : h-flex items-stretch size-full
  div nav  : v-flex w=220 border-r-1 border-color=border
    list notes  searchable  selectable  tag=pick
  div page  : v-flex flex-1
    toolbar bar
      button save  label=Save  icon=check  tag=save  ghost sm
      button del   label=Delete  icon=trash  tag=del  ghost sm danger
    editor body  soft-wrap  language=markdown  : flex-1
END

echo 'cmd-s save
cmd-n new
cmd-backspace del' >$ui/keys
echo 'item new label=New key=cmd-n
item save label=Save key=cmd-s
sep
item del label=Delete… key=cmd-backspace
sep
item quit label=Quit key=cmd-q' >$ui/menu/File
echo File >$ui/menu/bar
echo 'new alert-dialog sure title=''Delete this note?'' confirm=Delete cancel=Keep variant=danger tag=sure' >$m/over/ctl

# Item lines from awk are tab-separated, which works unchanged.
fn refresh { ls -p $n | awk '{ print $0 "\t" $0 "\ticon=file-text" }' >$m/nav/notes/items }
refresh
cur=()

fn pick {
	cur=$1
	echo $cur >$m/nav/notes/value
	cat $n/$cur >$m/page/body/value
	echo $cur' — Notes' >$m/title
}

cat $ui/events | while(ev=`{read}){
	switch($ev(1)^:^$ev(2)){
	case select:pick
		pick `{attr value}
	case click:save action:save
		if(! ~ $#cur 0){
			cat $m/page/body/value >$n/$cur
			echo 'notify Saved type=success' >$m/ctl
		}
	case action:new
		c=untitled-`{date -n}
		echo '# New note' >$n/$c
		refresh
		pick $c
		echo page/body >$m/focus
	case click:del action:del
		if(! ~ $#cur 0) echo open >$m/over/sure/ctl
	case action:quit
		echo quit >$ui/ctl
	case confirm:sure
		rm $n/$cur
		cur=()
		echo -n >$m/page/body/value
		refresh
	}
}
