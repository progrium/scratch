#!/bin/rc
# paint.rc: a finger-painting program on a canvas. Pick a color and a
# brush, drag to draw, undo, clear, save and load the drawing.
#
#	uitree -t Paint rc paint.rc
#
# Shows: canvas ops as a retained display list, one short ctl write per
# stroke segment (add path ...), coalesced drag events with x= y=, del for
# undo, the display list as the file format (save is cat ops >file),
# colors as theme tokens so a drawing follows dark mode.   Needs: M4
. ./lib.rc

m=$ui/win/main
echo 'set . title=Paint size=900,640 min=500,400 pos=center' >$m/ctl
cat >$m/tree <<'END'
div root  : v-flex size-full bg=background
  toolbar bar
    button-group color  value=foreground  tag=color
      button foreground  label=Ink
      button info  label=Blue
      button danger  label=Red
      button success  label=Green
      button warning  label=Amber
    separator s1  dir=col
    slider size  min=1  max=24  value=4  tag=size  : w=140
    separator s2  dir=col
    button undo  icon=undo  tag=undo  ghost sm
    button clear  icon=trash  tag=clear  ghost sm
    spacer sp
    button load  label=Open  tag=load  ghost sm
    button save  label=Save  tag=save  outline sm
  canvas c  on='mouse-down mouse-up drag'  : flex-1 cursor-crosshair
END
C=$m/c
# Save and Open use this file; /tmp, so a run leaves nothing behind.
file=/tmp/drawing.ops
echo 'cmd-z undo
cmd-s save
cmd-o load' >$ui/keys

fn blank { echo 'rect bg 0 0 4000 4000 fill=background' >$C/ops }
blank
color=foreground
size=4
n=0
strokes=()		# ids of the segments of each stroke, for undo
last=()

cat $ui/events | while(ev=`{read}){
	switch($ev(1)){
	case mouse-down
		x=`{attr x}; y=`{attr y}
		n=`{add $n 1}
		echo 'add circle d'$n' '$x' '$y' '`{echo $size | awk '{ print $1 / 2 }'}' fill='$color >$C/ctl
		last=($x $y)
		strokes=($strokes s$n)
		>/tmp/stroke.s$n
		echo d$n >>/tmp/stroke.s$n
	case drag
		if(~ $#last 2){
			x=`{attr x}; y=`{attr y}
			n=`{add $n 1}
			echo 'add path p'$n' M'$last(1)^','^$last(2)^' L'$x','$y' stroke='$color' width='$size' cap=round' >$C/ctl
			echo p$n >>/tmp/stroke.$strokes($#strokes)
			last=($x $y)
		}
	case mouse-up
		last=()
	case change
		switch($ev(2)){
		case color; color=`{attr value}
		case size;  size=`{attr value}
		}
	case click action
		switch($ev(2)){
		case undo
			if(! ~ $#strokes 0){
				s=$strokes($#strokes)
				for(i in `{cat /tmp/stroke.$s}) echo del $i >$C/ctl
				strokes=`{echo $strokes | awk '{ $NF = ""; print }'}
			}
		case clear
			blank
			strokes=()
		case save
			cat $C/ops >$file
			echo 'notify ''Saved '$file''' type=success' >$m/ctl
		case load
			if(test -f $file) cat $file >$C/ops
			strokes=()
		}
	}
}
