#!/bin/rc
# chat.rc: a chat window with a small rule-based assistant (an ELIZA in
# awk), with a typing indicator and markdown replies.
#
#	uitree -t Chat rc chat.rc
#
# Shows: message-list fed from one transcript file (id role time header,
# markdown body, blank line), stick-to-bottom, an input whose submit event
# carries no text (the client reads value), a typing placeholder replaced
# in place, avatars, a sheet with the raw transcript.   Needs: M3
. ./lib.rc

log=/tmp/chat.txt
>$log

m=$ui/win/main
echo 'set . title=Chat size=520,700 min=380,420 pos=center' >$m/ctl
cat >$m/tree <<'END'
div root  : v-flex size-full bg=background
  div head  : h-flex items-center gap=10 px=16 py=10 border-b-1 border-color=border
    avatar a  name=Eliza  sm
    div n  : v-flex flex-1
      text name  text=Eliza  : font-semibold
      text st  text=online  : text-xs text-color=muted-foreground
    button raw  icon=file-text  tag=raw  ghost sm
    button clear  icon=trash  tag=clear  ghost sm
  message-list msgs  stick-to-bottom  : flex-1 p=16
  div compose  : h-flex gap=8 p=12 border-t-1 border-color=border
    input in  placeholder='Message Eliza…'  tag=send  : flex-1
    button go  icon=send  tag=send  primary
END
M=$m/msgs
echo compose/in >$m/focus
echo 'new sheet raw side=right size=420 title=Transcript
new editor raw/e readonly soft-wrap language=markdown : size-full' >$m/over/ctl

n=0
fn say {
	# say role [text...]: append one message and redraw the list.
	# With no text, the markdown body is read from standard input.
	n=`{add $n 1}
	role=$1
	shift
	{
		echo m$n $role `{date | awk '{ print substr($4, 1, 5) }'}
		if(~ $#* 0) cat
		if not echo $"*
		echo
	} >>$log
	cat $log >$M/items
}
fn unsay {
	# drop the last message (the typing indicator)
	awk 'BEGIN { RS = ""; ORS = "\n\n" } { m[NR] = $0 } END { for(i = 1; i < NR; i++) print m[i] }' $log >$log.new
	mv $log.new $log
}
fn eliza {
	echo $"* | awk '{
		s = tolower($0)
		if(s ~ /^(hi|hello|hey)/)        { print "Hello! What would you like to talk about?"; exit }
		if(s ~ /i am|i.m /)              { sub(/.*(i am|i.m) /, "", s); print "How long have you been **" s "**?"; exit }
		if(s ~ /i feel/)                 { sub(/.*i feel /, "", s); print "Why do you feel " s "?"; exit }
		if(s ~ /because/)                { print "Is that the *real* reason?"; exit }
		if(s ~ /(mother|father|family)/) { print "Tell me more about your family."; exit }
		if(s ~ /(9p|plan 9|rc)/)         { print "Ah, a person of taste. Everything is a file:\n\n```rc\necho set . text=hello >$ui/win/main/ctl\n```"; exit }
		if(s ~ /\?$/)                    { print "Why do you ask?"; exit }
		n = split("Please go on.|I see.|What does that suggest to you?|Can you elaborate on that?", r, "|")
		srand(); print r[int(rand() * n) + 1]
	}'
}

say assistant 'Hello, I''m **Eliza**. How are you feeling today?'

cat $ui/events | while(ev=`{read}){
	switch($ev(1)^:^$ev(2)){
	case click:send submit:send
		t=`{cat $m/compose/in/value}
		if(! ~ $#t 0){
			echo -n >$m/compose/in/value
			say user $"t
			echo typing… >$m/head/n/st/text
			say assistant '_…_'
			sleep 1
			unsay
			eliza $"t | say assistant
			echo online >$m/head/n/st/text
		}
	case click:clear
		>$log
		cat $log >$M/items
	case click:raw
		cat $log >$m/over/raw/e/value
		echo open >$m/over/raw/ctl
	}
}
