-- window main Payroll
div root  : v-flex size-full p=20 gap=14 bg=background
  div head  : h-flex items-baseline gap=10
    text h  text='ACME Widget Co.'  : text-xl font-semibold
    text sub  text='Weekly payroll, computed in COBOL'  : text-sm text-color=muted-foreground
  form f  labels=side  tag=run
    field name  label=Employee
      input in  placeholder='Grace Hopper'
    field hours  label=Hours
      input in  placeholder=40
    field rate  label='Rate per hour'
      input in  placeholder=25.00
    field go  label=' '
      button run  primary  label='Run payroll'
  div body  : h-flex flex-1 gap=14 items-stretch
    div left  : v-flex gap=8 w=300
      text t1  text='Pay stub'  : font-semibold
      description-list stub  bordered  columns=1  items='Employee -'
    div right  : v-flex flex-1 gap=8
      text t2  text=Register  : font-semibold
      table reg  stripe  columns=<<END  : flex-1
emp Employee 170
hrs Hours 70 align=right
rate Rate 80 align=right
net 'Net pay' 110 align=right
END
      text total  text='No one paid yet.'  : text-sm text-right text-color=muted-foreground
-- menu/bar
-- keys
cmd-enter run
-- stderr
