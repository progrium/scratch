-- window main repl
div root  : v-flex size-full bg=background
  div bar  : h-flex items-center gap=8 px=12 py=6 border-b-1 border-color=border
    text what  text='A shell in Go, in stream mode'  : flex-1 text-sm font-semibold
    text size  text=80x24  : text-xs text-color=muted-foreground font-family=monospace
    button clear  ghost  xs  label=Clear
  div body  : flex-1 v-flex p=6 bg=background
    terminal sh  : flex-1
-- menu/bar
-- keys
-- stderr
