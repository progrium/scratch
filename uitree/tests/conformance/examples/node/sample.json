{
  "name": "uitreefs",
  "version": "0.2.0",
  "description": "GPUI Kit as a 9P file tree",
  "mount": "/mnt/ui",
  "protocol": {
    "event": ["name", "key", "path", "attrs"],
    "ctl": ["set", "new", "delete", "tree"],
    "here_values": true,
    "quoting": "Plan 9 tokenize"
  },
  "roots": {
    "win": "windows, each its own root node",
    "keys": "key bindings",
    "menu": "the app menu bar",
    "clip": "the clipboard",
    "drag": "drag payloads",
    "asset": "icons, images and fonts"
  },
  "clients": [
    { "lang": "rc", "examples": 15, "needs": null },
    { "lang": "Go", "examples": 2, "goos": "plan9" },
    { "lang": "C", "examples": 1 },
    { "lang": "awk", "examples": 1 },
    { "lang": "sed", "examples": 1, "note": "counts in Roman numerals" },
    { "lang": "PostScript", "examples": 1, "linux": true },
    { "lang": "COBOL", "examples": 1, "linux": true },
    { "lang": "jq", "examples": 1, "linux": true },
    { "lang": "Lua", "examples": 1, "linux": true },
    { "lang": "Node", "examples": 1, "linux": true },
    { "lang": "Python", "examples": 2, "linux": true },
    { "lang": "Ruby", "examples": 1, "linux": true }
  ],
  "limits": { "ctl_write": 65536, "queued_actions": 4096, "request_timeout_s": 5, "node_depth": 64 },
  "open_questions": 11,
  "it's": "quoted with ''"
}
