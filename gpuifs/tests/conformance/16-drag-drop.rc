#!/bin/rc
# 16-drag-drop: DESIGN § Drag and drop. A drop target's drop file, the drop
# request and /drags/<n>/data, accept and refuse, starting a drag.
# The headless backend starts a drag from /debug/inject (see README.md).
# milestone: M4
# needs: W1 W2 W3 W4 W7
. ./lib.rc
mainwin
wn=$k/windows/main
r=$wn/root
wq $r/ctl new div notes 'tag=pick'

echo '# the drop file lists accepted types'
w $r/notes/drop files text note
val $r/notes/drop
echo '# a text drop: payload in /drags/<n>/data, answered accept'
{
	inj drag 'n=7' 'type=text' 'data=hello world'
	inj event drop 'win=main' 'node=root/notes' 'type=text' 'drag=7' 'pt=40,212'
	evraw 'win=main' >/tmp/ev
	sed 's/ seq=[0-9]+//' /tmp/ev
	cat $k/drags/7/data
	echo
	s=`{seqof drop}
	w $r/notes/ctl accept 'seq='^$s
	echo '# /drags/7 goes once the request is answered'
	exists $k/drags/7
} <[3]$wn/events
echo '# a drop with no answer is refused after the timeout'
{
	inj drag 'n=8' 'type=text' 'data=x'
	inj event drop 'win=main' 'node=root/notes' 'type=text' 'drag=8' 'pt=1,1'
	evraw 'win=main' >/tmp/ev
	inj tick 5
	exists $k/drags/8
} <[3]$wn/events
echo '# starting a drag: dragstart, the client writes the payload, dragend'
wq $r/ctl new div card
w $r/card/on drag
w $r/card/drag-type note
{
	inj event dragstart 'win=main' 'node=root/card' 'drag=9'
	evs 'win=main'
	echo note-42 >$k/drags/9/data
	cat $k/drags/9/data
	inj event dragend 'win=main' 'node=root/card' 'drag=9' 'result=dropped' 'target=root/notes'
	evs 'win=main'
} <[3]$wn/events
