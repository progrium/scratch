#!/bin/sh
# run: the gpuifs conformance suite.
#
#	tests/conformance/run [-u] [-m M1|M2|M3|M4] [-g gpuifs] [-t secs] [test...]
#
# Runs each NN-name.rc with `gpuifs --headless rc ./NN-name.rc` in this
# directory and compares its standard output, followed by an `exit=N` line,
# with NN-name.out. If NN-name.trace exists, the headless trace (standard
# error) is compared with it too. Lines of both are compared after removing
# seq= attributes, whose numbering DESIGN.md doesn't fix.
#
#	-u   update the golden files from this run instead of comparing
#	-m   run only the tests whose `# milestone:` header is at or below this
#	-g   the gpuifs binary (default: $GPUIFS, then ../../target/debug/gpuifs)
#	-t   per-test timeout in seconds (default 30)
#
# Exit status 0 when every test that ran passed. Results and diffs go to
# standard output; actual outputs are kept in ./out/.
set -u
here=$(cd "$(dirname "$0")" && pwd)
cd "$here"

update=0
milestone=M4
gpuifs=${GPUIFS:-../../target/debug/gpuifs}
secs=30
while getopts um:g:t: o; do
	case $o in
	u) update=1 ;;
	m) milestone=$OPTARG ;;
	g) gpuifs=$OPTARG ;;
	t) secs=$OPTARG ;;
	*) sed -n '3p' "$0" >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))

if [ ! -x "$gpuifs" ] && ! command -v "$gpuifs" >/dev/null 2>&1; then
	echo "run: no gpuifs binary at $gpuifs (build it, or pass -g)" >&2
	exit 2
fi

if [ $# -eq 0 ]; then
	set -- $(ls [0-9][0-9]-*.rc | sed 's/\.rc$//')
else
	set -- $(for t; do basename "$t" .rc; done)
fi

mkdir -p out
rank() { echo "$1" | sed 's/^M//'; }
strip() { sed 's/ seq=[0-9][0-9]*//g' "$1"; }
timeout_cmd=$(command -v timeout || command -v gtimeout || true)

pass=0 fail=0 skip=0
for t; do
	need=$(sed -n 's/^# milestone: *\(M[0-9]\).*/\1/p' "$t.rc" | head -n 1)
	[ -n "$need" ] || need=M1
	if [ "$(rank "$need")" -gt "$(rank "$milestone")" ]; then
		echo "skip $t ($need)"
		skip=$((skip + 1))
		continue
	fi
	if [ -n "$timeout_cmd" ]; then
		"$timeout_cmd" "$secs" "$gpuifs" --headless rc "./$t.rc" >"out/$t.out" 2>"out/$t.trace"
	else
		"$gpuifs" --headless rc "./$t.rc" >"out/$t.out" 2>"out/$t.trace"
	fi
	echo "exit=$?" >>"out/$t.out"

	if [ $update -eq 1 ]; then
		strip "out/$t.out" >"$t.out"
		[ -f "$t.trace" ] && strip "out/$t.trace" >"$t.trace"
		echo "updated $t"
		continue
	fi

	ok=1
	if ! strip "out/$t.out" | diff -u "$t.out" - >"out/$t.diff"; then ok=0; fi
	if [ -f "$t.trace" ] && ! strip "out/$t.trace" | diff -u "$t.trace" - >>"out/$t.diff"; then ok=0; fi
	if [ $ok -eq 1 ]; then
		echo "pass $t"
		pass=$((pass + 1))
	else
		echo "FAIL $t"
		sed 's/^/	/' "out/$t.diff"
		fail=$((fail + 1))
	fi
done

echo "$pass passed, $fail failed, $skip skipped"
[ $fail -eq 0 ]
