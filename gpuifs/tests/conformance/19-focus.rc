#!/bin/rc
# 19-focus: DESIGN § Actions, keymaps and menus (Focus). The window focus
# file reads and moves focus; focus and blur are state events.
# milestone: M1
# needs: W1 W2 W3 W4 W6a (catalog half)
. ./lib.rc
mainwin
wn=$k/windows/main
wq $wn/root/ctl 'new input a
new input b'

echo '# nothing focused'
val $wn/focus
echo '# writing a path moves focus'
{
	w $wn/focus root/b
	val $wn/focus
	evs 'win=main'
} <[3]$wn/events
echo '# a path that is not there'
w $wn/focus root/nope
val $wn/focus
echo '# the user moves focus'
{
	inj event blur 'win=main' 'node=root/b'
	inj event focus 'win=main' 'node=root/a'
	inj mirror 'win=main' 'file=focus' 'value=root/a'
	evs 'win=main'
} <[3]$wn/events
val $wn/focus
