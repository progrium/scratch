#!/bin/rc
# 09-forms: DESIGN § Buttons and form controls. The form snippet, item files,
# uncontrolled values, controlled=on, and input change events with no text.
# milestone: M1
# needs: W1 W2 W3 W4 W5a W6a (catalog half)
. ./lib.rc
mainwin
wn=$k/windows/main
w=$wn/root

echo '# DESIGN''s form snippet'
wq $w/ctl new form prefs 'layout=v'
wq $w/prefs/ctl 'new field name label=Name
new field lang label=Language
new field ok'
wq $w/prefs/name/ctl 'new input in placeholder=''Your name'''
wq $w/prefs/lang/ctl 'new select in searchable=on'
echo 'rs|Rust
go|Go
c|C' | tr '|' '	' >$w/prefs/lang/in/items
wq $w/prefs/ok/ctl 'new button save label=Save style=primary tag=save'
cat $w/prefs/tree
echo '# items read back as written'
cat $w/prefs/lang/in/items

echo '# a select takes only ids in its items'
w $w/prefs/lang/in/value go
val $w/prefs/lang/in/value
w $w/prefs/lang/in/value fortran
val $w/prefs/lang/in/value

echo '# user events: the input says only that it changed'
{
	inj mirror 'win=main' 'node=root/prefs/name/in' 'file=value' 'value=Ada Lovelace'
	inj event change 'win=main' 'node=root/prefs/name/in'
	inj mirror 'win=main' 'node=root/prefs/name/in' 'file=value' 'value=Ada'
	inj event change 'win=main' 'node=root/prefs/name/in'
	inj event submit 'win=main' 'node=root/prefs/name/in'
	inj mirror 'win=main' 'node=root/prefs/lang/in' 'file=value' 'value=rs'
	inj event change 'win=main' 'node=root/prefs/lang/in' 'value=rs'
	inj event click 'win=main' 'node=root/prefs/ok/save'
	evs 'win=main'
} <[3]$wn/events
echo '# the client reads the text from value'
val $w/prefs/name/in/value
val $w/prefs/lang/in/value

echo '# checkbox values'
wq $w/ctl new checkbox cb 'label=Remember me'
val $w/cb/value
w $w/cb/value on
w $w/cb/value mixed
val $w/cb/value
w $w/cb/value yes
echo '# a client write is an echo with via=ctl'
{
	w $w/cb/value off
	evs 'win=main'
} <[3]$wn/events
echo '# controlled=on: the user''s change is an event, the value waits for the client'
w $w/cb/controlled on
{
	inj event change 'win=main' 'node=root/cb' 'value=on'
	evs 'win=main'
} <[3]$wn/events
val $w/cb/value

echo '# secret inputs keep a readable value'
wq $w/ctl new input pass 'flags=secret'
echo hunter2 >$w/pass/value
val $w/pass/value
echo '# slider ranges and bad numbers'
wq $w/ctl new slider vol 'min=0' 'max=100' 'step=5'
w $w/vol/value 40
w $w/vol/value '20 80'
val $w/vol/value
w $w/vol/value loud
echo '# radio-group items are id label lines'
wq $w/ctl new radio-group size
echo 's|Small
m|Medium' | tr '|' '	' >$w/size/items
w $w/size/value m
val $w/size/value
