#!/bin/rc
# tree-phase.rc: run one example's tree-building phase headless and print
# what it built. Run from gpuifs/ (the machine's working directory):
#
#	gpuifs --headless rc tests/conformance/tree-phase.rc examples/rc hello.rc [arg...]
#	gpuifs --headless rc tests/conformance/tree-phase.rc examples/awk awk -f csvview.awk planets.csv
#
# The first argument is the directory to run in; the rest is the command
# (an .rc file name alone means rc NAME). The example runs in the
# background; once its windows' trees stop changing (two reads half a second
# apart agree, for up to 15 seconds) this prints each window's title and
# tree, the menus, the keymap and anything the example wrote to standard
# error, which in the tree-building phase means a write the tree refused.
# Then it quits the app, as a user would.
. tests/conformance/lib.rc

dir=$1
shift
cmd=($*)
if(~ $#cmd 1 && ~ $cmd *.rc) cmd=(rc $cmd)

fn snap {
	for(win in `{ls -p $k/windows}) {
		echo '-- window' $win `{cat $k/windows/$win/title}
		cat $k/windows/$win/root/tree
		for(ov in `{ls -p $k/windows/$win/overlays}) if(test -d $k/windows/$win/overlays/$ov) {
			echo '-- overlay' $win/$ov
			cat $k/windows/$win/overlays/$ov/tree
		}
	}
}

@{ cd $dir; $cmd >/tmp/ex.out >[2]/tmp/ex.err } &

prev=''
i=0
stable=()
while(~ $#stable 0 && ! ~ $i 30) {
	sleep 0.5
	snap >/tmp/snap.new >[2]/dev/null
	if(test -s /tmp/snap.new && cmp -s /tmp/snap.new /tmp/snap.old) stable=1
	cp /tmp/snap.new /tmp/snap.old
	i=`{echo $i | awk '{ print $1 + 1 }'}
}
if(~ $#stable 0) echo '-- not stable after 15 seconds'
cat /tmp/snap.new
for(m in `{ls -p $k/menus}) {
	echo '-- menu' $m
	cat $k/menus/$m
}
echo '-- keymap'
cat $k/keymap
echo '-- stderr'
cat /tmp/ex.err
echo quit >$k/ctl
