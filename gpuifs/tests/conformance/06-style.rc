#!/bin/rc
# 06-style: DESIGN § Style language. Every word form, unknown words, writes
# that never half-apply, and size and variant words that only components take.
# milestone: M1
# needs: W1 W2 W3 W4 W5a W6a
. ./lib.rc
mainwin
r=$k/windows/main/root
w $r/ctl new div card
s=$r/card/style

echo '# each form'
w $s flex_col items_center size_full rounded_md overflow_y_scroll cursor_pointer
w $s 'w=240' 'gap=12' 'p=16' 'text_size=13'
w $s 'w=50%' 'px=1.5rem'
w $s 'bg=primary' 'text_color=muted_foreground' 'border_color=border'
w $s 'bg=#1e1e2e' 'border_color=#1e1e2e80'
w $s 'shadow=0,4,12,#0003'
w $s 'hover:bg=accent' 'active:bg=muted' 'focus:border_color=ring' 'disabled:opacity=0.5'
w $s 'group:card' 'h_flex'
w $s 'group-hover(card):text_color=primary'
w $s v_flex h_flex
echo '# a write replaces the words'
w $s 'h_flex gap=8 p=12 rounded_lg bg=muted hover:bg=accent cursor_pointer'
val $s
echo '# an unknown word, with its detail'
wd $s flexx
echo '# one bad word and nothing changes'
w $s 'v_flex flexx p=4'
val $s
echo '# bad values'
w $s 'w=wide'
w $s 'bg=#12'
w $s 'bg=no_such_token'
w $s 'flex_col=3'
w $s 'sideways:bg=accent'
val $s
echo '# size and variant words fail on a raw div'
w $s primary
w $s sm
echo '# and work on a component that has them'
w $r/ctl new button b 'label=Go'
w $r/b/style primary sm
val $r/b/style
echo '# a variant the component lacks'
w $r/ctl new checkbox cb 'label=x'
w $r/cb/style danger
echo '# style= on new is checked the same way'
w $r/ctl 'new div bad style=''flexx'''
exists $r/bad
