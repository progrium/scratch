#!/bin/rc
# 25-trace: DESIGN § The tree (trace), § Who can reach the tree. Every applied
# write is one trace line; failed writes are not; secret values never appear.
# The headless trace goes to standard error and is compared with
# 25-trace.trace; the line format there is this suite's proposal (README.md).
# milestone: M1
# needs: W1 W2 W3 W4 W6a (catalog half)
. ./lib.rc
mainwin
r=$k/windows/main/root

wq $r/ctl 'new text a text=hi
new input pass flags=secret'
mkdir $r/b
echo Hello >$r/a/text
echo 'line one
line two' >$r/a/text
echo hunter2 >$r/pass/value
wq $r/ctl 'new input pin flags=secret value=1234'
w $r/a/style flexx
rm -r $r/b
wq $k/windows/main/ctl begin
inj tick 2
echo done
