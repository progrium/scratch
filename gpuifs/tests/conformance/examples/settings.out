-- window settings Settings
div root  style='h_flex size_full bg=background'
  sidebar nav  style=w=220  collapsible=off
    sidebar-group g  label=Settings
      sidebar-item general  label=General  icon=settings  active=on  tag=page:general
      sidebar-item look  label=Appearance  icon=palette  tag=page:look
      sidebar-item account  label=Account  icon=user  tag=page:account
      sidebar-item keys  label=Shortcuts  icon=keyboard  tag=page:keys
  scroll page  style='flex_1 overflow_y_scroll p=32'  order=general
    div general  style='v_flex gap=24 max_w=560'
      text h  style='text_xl font_semibold'  text=General
      group-box startup  title=Startup
        div rows  style='v_flex gap=12'
          switch login  label='Open at login'  tag=set:login
          switch restore  label='Reopen windows from last time'  value=on  tag=set:restore
          switch updates  label='Check for updates automatically'  value=on  tag=set:updates
      group-box lang  title=Language
        form f  layout=h  label_width=140
          field l  label='Interface language'
            select in  value=en  tag=set:lang  items=<<END
en	English
fr	Français
de	Deutsch
ja	日本語

            END
          field n  label='Recent items'  description='How many files Open Recent lists.'
            number-input in  value=10  min=0  max=50  tag=set:recent
    div look  style='v_flex gap=24 max_w=560'
      text h  style='text_xl font_semibold'  text=Appearance
      group-box theme  title=Theme
        form f  layout=h  label_width=140
          field mode  label=Mode
            radio-group in  value=light  dir=h  tag=set:mode  items=<<END
light	Light
dark	Dark

            END
          field name  label=Theme
            select in  searchable=on  value=Default  tag=set:theme  items=<<END
Default	Default
Catppuccin	Catppuccin
Tokyo Night	Tokyo Night
Gruvbox	Gruvbox
Ayu	Ayu

            END
          field radius  label='Corner radius'
            slider in  max=16  value=6  tag=set:radius
          field size  label='Font size'
            slider in  min=11  max=18  value=14  tag=set:font_size
      alert note  title='Changes apply right away'  text='Every style that names a theme token re-resolves on the next frame.'
    div account  style='v_flex gap=24 max_w=560'
      text h  style='text_xl font_semibold'  text=Account
      div who  style='h_flex items_center gap=12'
        avatar a  name='Ada Lovelace'  style=lg
        div n  style=v_flex
          text name  style=font_semibold  text='Ada Lovelace'
          text mail  style='text_sm text_color=muted_foreground'  text=ada@example.com
      form f  layout=v
        field name  label='Display name'
          input in  value='Ada Lovelace'  tag=set:name
        field mail  label=Email
          input in  value=ada@example.com  tag=set:email
      div danger  style='h_flex gap=8'
        button out  label='Sign out'  style=outline  tag=signout
        button del  label='Delete account'  style='danger ghost'  tag=delete
    div keys  style='v_flex gap=24 flex_1'
      text h  style='text_xl font_semibold'  text=Shortcuts
      table t  stripe=on  sortable=on  sorted=on  style=h=320  columns=<<END  rows=<<END
key	Shortcut	160	sort
id	Action	240	sort

      END
1	cmd-,	settings
2	cmd-w	close-window
3	cmd-1	page:general
4	cmd-2	page:look
5	cmd-3	page:account
6	cmd-4	page:keys

      END
-- keymap
cmd-,        settings
cmd-w        close-window
cmd-1        page:general
cmd-2        page:look
cmd-3        page:account
cmd-4        page:keys
-- stderr
