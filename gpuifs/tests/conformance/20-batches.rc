#!/bin/rc
# 20-batches: DESIGN § Atomic updates (Batches). begin, commit and abort on a
# window ctl; reads see uncommitted writes; no batch; the 2 second timeout.
# What the window draws is checked by the host's TestAppContext harness; here
# the trace (25-trace) and the tree are what a client can see.
# milestone: M1
# needs: W1 W2 W3 W4
. ./lib.rc
mainwin
wn=$k/windows/main
r=$wn/root

echo '# commit or abort with no begin'
w $wn/ctl commit
w $wn/ctl abort
echo '# reads see writes inside a batch'
w $wn/ctl begin
w $r/ctl new text a 'text=inside'
val $r/a/text
w $wn/ctl commit
val $r/a/text
echo '# abort throws the batch away'
w $wn/ctl begin
w $r/ctl new text b 'text=gone soon'
w $r/a/text changed
exists $r/b
w $wn/ctl abort
exists $r/b
val $r/a/text
echo '# begin inside a batch'
w $wn/ctl begin
w $wn/ctl begin
w $wn/ctl abort
echo '# a batch left open is committed after 2 seconds'
w $wn/ctl begin
w $r/ctl new text c 'text=late'
inj tick 2
w $wn/ctl commit
exists $r/c
