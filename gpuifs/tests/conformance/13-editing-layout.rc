#!/bin/rc
# 13-editing-layout: DESIGN § Editing and rich content, § Layout. The editor
# snippet, diagnostics, completions by seq, and the dock's layout file.
# milestone: M1
# needs: W1 W2 W3 W4 W5a W6d (catalog half)
. ./lib.rc
mainwin
wn=$k/windows/main
r=$wn/root

echo '# DESIGN''s editor snippet'
e=$r/src
w $r/ctl new editor src 'language=rust' 'line_numbers=on'
echo 'fn main() {
    let x: i32 = "one";
}' >$e/value
cat $e/value
echo '12|5|3|error|mismatched types' | tr '|' '	' >$e/diagnostics
cat $e/diagnostics
echo '# multi-line values keep their bytes, trailing newline included'
val $e/value | sed -n '$p'
echo '# selection reads and writes line col line col'
w $e/selection 1 1 1 3
val $e/selection
w $e/selection 1 1
echo '# a bad severity'
echo '1|1|1|fatal|x' | tr '|' '	' >$e/diagnostics
cat $e/diagnostics
echo '# cursor is state, save and complete are actions and requests'
{
	inj event cursor 'win=main' 'node=root/src' 'line=1' 'col=2'
	inj event cursor 'win=main' 'node=root/src' 'line=2' 'col=5'
	inj event save 'win=main' 'node=root/src'
	inj event complete 'win=main' 'node=root/src' 'line=2' 'col=5' 'prefix=le'
	evraw 'win=main' >/tmp/ev
} <[3]$wn/events
sed 's/ seq=[0-9]+//' /tmp/ev
echo '# completions answer the request by seq; a stale seq is dropped'
s=`{seqof complete}
echo 'seq='^$s'
let|let
loop|loop' | tr '|' '	' >$e/completions
echo 'seq=1
x|x' | tr '|' '	' >$e/completions
echo '# a markdown text keeps its bytes'
w $r/ctl new markdown md
echo '# Title

Some *text*.' >$r/md/text
cat $r/md/text

echo '# DESIGN''s dock snippet'
d=$r/ws
w $r/ctl new dock ws 'style=size_full'
w $d/ctl 'new dock-panel files title=Files icon=folder zone=left
new dock-panel src title=main.rs zone=center
new dock-panel log title=Output zone=bottom'
w $d/ctl 'new dock-panel x zone=middle'
echo '# layout reads back as JSON; writing it back is accepted'
cat $d/layout >/tmp/layout.json
sed 1q /tmp/layout.json | grep -c '^[	 ]*[{]'
cat /tmp/layout.json >$d/layout
echo '# a layout that is not JSON is refused and the old one stays'
echo 'not json' >$d/layout
cmp -s /tmp/layout.json $d/layout && echo same

echo '# accordion, collapsible, resizable panels'
w $r/ctl new accordion acc 'multiple=on'
w $r/acc/ctl 'new accordion-item a title=One
new accordion-item b title=Two'
w $r/acc/value a b
val $r/acc/value
w $r/ctl new resizable rz 'dir=h'
w $r/rz/ctl 'new panel left size=240 min=120
new panel right'
w $r/rz/ctl new div notpanel
