#!/bin/rc
# 03-create: DESIGN § Creating nodes. mkdir, `new` and a tree document make
# the same tree; `delete` and rm -r remove a node; names are never reused
# while they exist.
# milestone: M1
# needs: W1 W2 W3 W4 W5a
. ./lib.rc
mainwin
r=$k/windows/main/root

w $r/ctl new div one
w $r/ctl new div two
w $r/ctl new div three

echo '# 1. mkdir and files'
mkdir $r/one/save
w $r/one/save/type button
w $r/one/save/label Save
w $r/one/save/style primary
w $r/one/save/tag save
cat $r/one/tree

echo '# 2. a new verb'
w $r/two/ctl new button save 'label=Save' 'style=primary' 'tag=save'
cat $r/two/tree

echo '# 3. a tree document'
echo 'div three
  button save  label=Save  style=primary  tag=save' >$r/three/tree
cat $r/three/tree

echo '# mkdir appends to order, as new does'
mkdir $r/four
val $r/order

echo '# a name in use'
w $r/ctl new div one
w $r/ctl new text one

echo '# delete on the parent ctl'
w $r/ctl delete two
exists $r/two
val $r/order
echo '# delete of a name that is not there'
w $r/ctl delete two

echo '# rm -r'
rm -r $r/one
exists $r/one $r/one/save
val $r/order

echo '# the name is free again'
w $r/ctl new text one 'text=back'
val $r/one/type $r/one/text
