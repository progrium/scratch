#!/bin/rc
# 12-data: DESIGN § Data display. Items-are-files: list items, table
# columns and rows, append, sort requests, tree items, progress.
# milestone: M1
# needs: W1 W2 W3 W4 W5a W6c (catalog half)
. ./lib.rc
mainwin
wn=$k/windows/main
r=$wn/root

echo '# list items: the select format, with groups and separators'
w $r/ctl new list l 'selectable=on'
echo '# Fruit
apple|Apple|icon=apple
pear|Pear|disabled
-
# Veg
leek|Leek' | tr '|' '	' >$r/l/items
cat $r/l/items
echo '# a malformed items file is refused whole and the old one stays'
echo '|Nameless' | tr '|' '	' >$r/l/items
cat $r/l/items | count

echo '# DESIGN''s table snippet'
t=$r/files
w $r/ctl new table files 'stripe=on' 'selectable=row' 'sortable=on'
echo 'name|Name|280|sort
size|Size|90|sort|align=right
mod|Modified|160|sort' | tr '|' '	' >$t/columns
echo '1|a.txt|12|Nov 21 10:00
2|b.txt|300|Nov 21 11:00' | tr '|' '	' >$t/rows
cat $t/columns $t/rows
echo '# append adds rows, one write at a time'
echo '3|c.txt|7|Nov 21 12:00' | tr '|' '	' >>$t/append
echo '4|d.txt|9|Nov 21 13:00' | tr '|' '	' >>$t/append
cat $t/rows | count
echo '# user events: select is state, sort and scrolled_to_end are actions'
{
	inj event select 'win=main' 'node=root/files' 'row=1' 'col=name'
	inj event select 'win=main' 'node=root/files' 'row=2' 'col=name'
	inj event sort 'win=main' 'node=root/files' 'col=size' 'dir=desc'
	inj event scrolled_to_end 'win=main' 'node=root/files'
	evs 'win=main'
} <[3]$wn/events
echo '# sorted=on lets the host sort'
w $t/sorted on

echo '# tree items and expanded ids'
w $r/ctl new tree tr
echo 'src|-|src|icon=folder
main|src|main.rs
docs|-|docs' | tr '|' '	' >$r/tr/items
w $r/tr/expanded src
val $r/tr/expanded
w $r/tr/expanded nope

echo '# progress takes 0 to 100, or empty'
w $r/ctl new progress p
w $r/p/value 40
w $r/p/value 140
val $r/p/value
echo -n >$r/p/value
val $r/p/value

echo '# description-list, badge, kbd'
w $r/ctl new description-list dl 'bordered=on'
echo 'Name|gpuifs
Version|0.1' | tr '|' '	' >$r/dl/items
cat $r/dl/items
w $r/ctl new badge bd 'count=3' 'max=99'
w $r/ctl new kbd kb 'key=cmd-shift-p'
val $r/kb/key
