#!/bin/rc
# 21-tree-docs: DESIGN § Atomic updates (Subtree documents). Reading and
# writing a node's tree file, keep-by-name-and-type, text=<<END blocks, and
# a document that round-trips.
# milestone: M1
# needs: W1 W2 W3 W4 W5a W6a W6b (catalog halves)
. ./lib.rc
mainwin
wn=$k/windows/main
r=$wn/root

cat >$r/tree <<'END_DOC'
div root  style='v_flex size_full p=24 gap=16'
  text title  style='text_xl font_semibold'  text='Sign in'
  form f  layout=v
    field user  label=Email
      input in  placeholder=you@example.com
    field pass  label=Password
      input in  flags=secret
    field go
      button submit  label='Sign in'  style='primary w_full'  tag=login
  link help  label='Forgot password?'  href=https://example.com/reset
END_DOC

echo '# DESIGN''s sign-in document reads back as written'
cat $r/tree
echo '# the directory view is the same tree'
val $r/title/text $r/f/user/in/placeholder $r/f/go/submit/tag
val $r/order $r/f/order
echo '# a save and restore round-trips'
cat $r/tree >/tmp/screen.ui
cat /tmp/screen.ui >$r/tree
cat $r/tree >/tmp/screen2.ui
cmp -s /tmp/screen.ui /tmp/screen2.ui && echo same

echo '# a rewrite keeps children whose name and type match'
echo 'Ada' >$r/f/user/in/value
cat >$r/tree <<'END_DOC'
div root  style='v_flex size_full p=24 gap=16'
  form f  layout=v
    field user  label='Your email'
      input in  placeholder=you@example.com
  text title  text='Welcome back'
END_DOC
val $r/f/user/in/value
val $r/order
exists $r/help $r/f/pass
echo '# a child whose type changed is replaced, so its state goes'
cat >$r/tree <<'END_DOC'
div root
  form f
    field user
      textarea in
END_DOC
val $r/f/user/in/type $r/f/user/in/value

echo '# a text=<<END block'
cat >$r/tree <<'END_DOC'
div root
  markdown notes  text=<<END
# Notes

- one
- two
END
END_DOC
cat $r/notes/text
cat $r/tree

echo '# a document with a bad line changes nothing'
cat >$r/tree <<'END_DOC'
div root
  nosuchtype x
END_DOC
exists $r/notes $r/x
echo '# indentation that skips a level'
cat >$r/tree <<'END_DOC'
div root
      text deep
END_DOC
exists $r/deep
echo '# the root line must match the node it is written to'
cat >$r/tree <<'END_DOC'
text other
END_DOC
val $r/type
