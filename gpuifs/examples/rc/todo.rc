#!/bin/rc
# todo.rc: the classic to-do list. Add with Enter, tick to complete,
# filter All / Active / Done, clear completed. Saved to todo.txt in the cwd.
#
#	gpuifs -t Todos rc todo.rc
#
# Shows: one node per item made with new and delete, group-hover styles
# (the delete button appears on row hover with no round trip), the order
# file as a filter (a child not listed is not drawn), tags carrying ids,
# checkbox change events, tabs.   Needs: M3
. ./lib.rc

db=todo.txt
touch $db

echo 'window main title=Todos size=460,560 min=360,400 pos=center' >$k/ctl
r=$k/windows/main/root
cat >$r/tree <<'END'
div root  style='v_flex size_full p=24 gap=12 bg=background'
  text h  style='text_2xl font_semibold'  text=Todos
  input new  placeholder='What needs to be done?'  flags=cleanable  tag=add
  scroll body  style='flex_1 overflow_y_scroll'
    div items  style='v_flex gap=2'
    empty none  title='Nothing to do'  description='Add a task above.'  icon=inbox
  div foot  style='h_flex items_center gap=8 pt=8 border_t_1 border_color=border'
    text count  style='text_sm text_color=muted_foreground flex_1'
    tabs filter  style='segmented sm'  value=all
      tab all  label=All
      tab active  label=Active
      tab done  label=Done
    button clear  label='Clear completed'  style='ghost sm'  tag=clear
END
L=$r/body/items
echo root/new >$k/windows/main/focus

n=0
all=()
filter=all

# mk id text [on|off]: make one item row
fn mk {
	echo 'new div '$1' tag=row:'$1' style=''h_flex items_center gap=8 px=8 py=6 rounded_md hover:bg=muted group:row''' >$L/ctl
	echo 'new checkbox done tag=done:'$1'
new text label style=flex_1
new button del icon=close tag=del:'$1' style=''ghost xs invisible group-hover(row):visible''' >$L/$1/ctl
	echo $2 >$L/$1/label/text
	if(~ $3 on) { echo on >$L/$1/done/value; strike $1 on }
	all=($all $1)
}

# strike id on|off: style a done item's label
fn strike {
	if(~ $2 on) echo 'flex_1 line_through text_color=muted_foreground' >$L/$1/label/style
	if not echo flex_1 >$L/$1/label/style
}

# without x list...: the list with x left out
fn without {
	x=$1
	shift
	for(i in $*) if(! ~ $i $x) echo $i
}

# show: apply the filter through order, update the count and save
fn show {
	o=()
	left=0
	>$db
	for(i in $all){
		d=`{cat $L/$i/done/value}
		if(~ $d off) left=`{add $left 1}
		switch($filter){
		case all
			o=($o $i)
		case active
			if(~ $d off) o=($o $i)
		case done
			if(~ $d on) o=($o $i)
		}
		echo $d `{cat $L/$i/label/text} >>$db
	}
	echo $o >$L/order
	if(~ $#all 0) echo items none >$r/body/order
	if not echo items >$r/body/order
	if(~ $left 1) echo '1 item left' >$r/foot/count/text
	if not echo $left items left >$r/foot/count/text
}

# Load saved items: lines of "on|off text..."
ifs='
' { lines=`{cat $db} }
for(line in $lines){
	w=`{echo $line}
	text=$w(2-)
	n=`{add $n 1}
	mk t$n $"text $w(1)
}
show

cat $k/events | while(ev=`{read}){
	t=`{attr tag}
	id=`{echo $t | sed 's/^[^:]*://'}
	switch($ev(1)){
	case submit
		v=`{cat $r/new/value}
		if(! ~ $#v 0){
			n=`{add $n 1}
			mk t$n $"v off
			echo -n >$r/new/value
			show
		}
	case change
		switch($t){
		case done:*
			strike $id `{attr value}
			show
		case *
			if(has 'node=root/foot/filter') { filter=`{attr value}; show }
		}
	case click
		switch($t){
		case del:*
			echo delete $id >$L/ctl
			all=`{without $id $all}
			show
		case clear
			for(i in $all) if(~ `{cat $L/$i/done/value} on) {
				echo delete $i >$L/ctl
				all=`{without $i $all}
			}
			show
		}
	case *
		stdquit
	}
}
