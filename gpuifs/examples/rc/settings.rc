#!/bin/rc
# settings.rc: a settings window in the style of GPUI Kit's gallery:
# a sidebar of pages, and pages of grouped controls. Appearance changes
# apply live, by writing theme tokens and theme/mode.
#
#	gpuifs -t Settings rc settings.rc
#
# Shows: sidebar navigation, pages kept alive and switched with order (so
# their controls keep their values), switch, select, slider, radio-group,
# number-input, a table of shortcuts read from the keymap, theme tokens
# changed live, settings saved as name=value lines.   Needs: M3
. ./lib.rc

db=settings.txt
touch $db

echo 'window settings title=Settings size=820,560 min=640,420 pos=center' >$k/ctl
r=$k/windows/settings/root

cat >$r/tree <<'END'
div root  style='h_flex size_full bg=background'
  sidebar nav  style=w=220  collapsible=off
    sidebar-group g  label=Settings
      sidebar-item general  label=General  icon=settings  active=on  tag=page:general
      sidebar-item look  label=Appearance  icon=palette  tag=page:look
      sidebar-item account  label=Account  icon=user  tag=page:account
      sidebar-item keys  label=Shortcuts  icon=keyboard  tag=page:keys
  scroll page  style='flex_1 overflow_y_scroll p=32'
    div general  style='v_flex gap=24 max_w=560'
      text h  style='text_xl font_semibold'  text=General
      group-box startup  title=Startup
        div rows  style='v_flex gap=12'
          switch login  label='Open at login'  tag=set:login
          switch restore  label='Reopen windows from last time'  value=on  tag=set:restore
          switch updates  label='Check for updates automatically'  value=on  tag=set:updates
      group-box lang  title=Language
        form f  layout=h  label_width=140
          field l  label='Interface language'
            select in  value=en  tag=set:lang
          field n  label='Recent items'  description='How many files Open Recent lists.'
            number-input in  value=10  min=0  max=50  tag=set:recent
    div look  style='v_flex gap=24 max_w=560'
      text h  style='text_xl font_semibold'  text=Appearance
      group-box theme  title=Theme
        form f  layout=h  label_width=140
          field mode  label=Mode
            radio-group in  value=light  dir=h  tag=set:mode
          field name  label=Theme
            select in  searchable=on  value=Default  tag=set:theme
          field radius  label='Corner radius'
            slider in  min=0  max=16  step=1  value=6  tag=set:radius
          field size  label='Font size'
            slider in  min=11  max=18  step=1  value=14  tag=set:font_size
      alert note  variant=info  title='Changes apply right away'  text='Every style that names a theme token re-resolves on the next frame.'
    div account  style='v_flex gap=24 max_w=560'
      text h  style='text_xl font_semibold'  text=Account
      div who  style='h_flex items_center gap=12'
        avatar a  name='Ada Lovelace'  style=lg
        div n  style=v_flex
          text name  style=font_semibold  text='Ada Lovelace'
          text mail  style='text_sm text_color=muted_foreground'  text=ada@example.com
      form f  layout=v
        field name  label='Display name'
          input in  value='Ada Lovelace'  tag=set:name
        field mail  label=Email
          input in  value=ada@example.com  tag=set:email
      div danger  style='h_flex gap=8'
        button out  label='Sign out'  style=outline  tag=signout
        button del  label='Delete account'  style='danger ghost'  tag=delete
    div keys  style='v_flex gap=24 flex_1'
      text h  style='text_xl font_semibold'  text=Shortcuts
      table t  stripe=on  sortable=on  sorted=on  style=h=320
END
p=$r/page
echo general >$p/order

# Data files: tabs and alignment come from tsv (lib.rc).
tsv >$p/general/lang/f/l/in/items <<'END'
en | English
fr | Français
de | Deutsch
ja | 日本語
END
tsv >$p/look/theme/f/mode/in/items <<'END'
light | Light
dark  | Dark
END
tsv >$p/look/theme/f/name/in/items <<'END'
Default     | Default
Catppuccin  | Catppuccin
Tokyo Night | Tokyo Night
Gruvbox     | Gruvbox
Ayu         | Ayu
END
tsv >$p/keys/t/columns <<'END'
key | Shortcut | 160 | sort
id  | Action   | 240 | sort
END
cat >$k/keymap <<'END'
cmd-,        settings
cmd-w        close-window
cmd-1        page:general
cmd-2        page:look
cmd-3        page:account
cmd-4        page:keys
END
awk 'BEGIN { OFS = "\t" } NF >= 2 { print NR, $1, $2 }' $k/keymap >$p/keys/t/rows

# Saved settings: name=value lines, applied by the same code as a change.
fn apply {
	n=$1
	shift
	switch($n){
	case mode
		echo $1 >$k/theme/mode
	case theme
		echo $"* >$k/theme/name
	case radius font_size
		echo $n $1 >$k/theme/tokens
	}
}
fn save {
	n=$1
	shift
	grep -v '^'$n'=' $db >/tmp/settings.new
	echo $n^'='^$"* >>/tmp/settings.new
	cat /tmp/settings.new >$db
}
ifs='
' { saved=`{cat $db} }
for(kv in $saved) apply `{echo $kv | sed 's/=/ /'}

cur=general
fn go {
	echo off >$r/nav/g/$cur/active
	echo on >$r/nav/g/$1/active
	echo $1 >$p/order
	cur=$1
}

# Events say what changed; the value file says what it is now, so a value
# with blanks in it ("Tokyo Night") never has to be unquoted here.
cat $k/events | while(ev=`{read}){
	w=`{attr tag; attr id}
	switch($ev(1)){
	case click action
		switch($"w){
		case page:*
			go `{echo $"w | sed 's/^page://'}
		case signout delete
			echo 'notify ''Not in this example'' type=info' >$k/windows/settings/ctl
		}
	case change
		switch($"w){
		case set:*
			name=`{echo $"w | sed 's/^set://'}
			v=`{cat $k/windows/settings/`{attr node}^/value}
			apply $name $v
			save $name $v
		}
	case *
		stdquit
	}
}
