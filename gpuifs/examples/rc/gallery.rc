#!/bin/rc
# gallery.rc: a recreation of GPUI Kit's component gallery (its "story"
# app): a sidebar of components, and a live story for each one. Every
# event the story sends is shown in the status bar, so this doubles as a
# way to learn what each component reports.
#
#	gpuifs -t Gallery rc gallery.rc
#
# Shows: most of the catalog; screens as files (each story is a tree
# document in gallery/, written to the same node, so switching stories is
# one write); theme/mode; popover and tooltip with no round trip; dialogs
# and notifications from ctl.
# Needs: M3 (the editor story needs W6d, the chart story W6c)
. ./lib.rc

echo 'window main title=''GPUI Kit Gallery'' size=1100,720 min=800,520 pos=center' >$k/ctl
w=$k/windows/main
r=$w/root

cat >$r/tree <<'END'
div root  style='h_flex size_full bg=background'
  sidebar nav  style=w=230
    div header  style='h_flex items_center gap=8 p=12'
      icon logo  name=layout-dashboard  style='size=18 text_color=primary'
      text name  style=font_semibold  text='GPUI Kit'
    sidebar-group basic  label=Basic
      sidebar-item button  label=Button  tag=story:button  active=on
      sidebar-item badge  label='Badge & Tag'  tag=story:badge
      sidebar-item avatar  label=Avatar  tag=story:avatar
      sidebar-item kbd  label=Kbd  tag=story:kbd
    sidebar-group form  label=Form
      sidebar-item input  label=Input  tag=story:input
      sidebar-item toggles  label='Checkbox & Switch'  tag=story:toggles
      sidebar-item select  label=Select  tag=story:select
      sidebar-item slider  label=Slider  tag=story:slider
      sidebar-item date  label='Date Picker'  tag=story:date
    sidebar-group data  label=Data
      sidebar-item table  label=Table  tag=story:table
      sidebar-item tree  label=Tree  tag=story:tree
      sidebar-item progress  label=Progress  tag=story:progress
      sidebar-item chart  label=Chart  tag=story:chart
    sidebar-group overlay  label=Overlay
      sidebar-item dialog  label=Dialog  tag=story:dialog
      sidebar-item popover  label='Popover & Tooltip'  tag=story:popover
      sidebar-item notify  label=Notification  tag=story:notify
    sidebar-group layout  label=Layout
      sidebar-item tabs  label=Tabs  tag=story:tabs
      sidebar-item accordion  label=Accordion  tag=story:accordion
      sidebar-item resizable  label=Resizable  tag=story:resizable
    sidebar-group text  label=Text
      sidebar-item editor  label=Editor  tag=story:editor
      sidebar-item markdown  label=Markdown  tag=story:markdown
  div main  style='v_flex flex_1'
    div head  style='h_flex items_center gap=12 px=24 py=16 border_b_1 border_color=border'
      div t  style='v_flex flex_1'
        text title  style='text_xl font_semibold'
        text desc  style='text_sm text_color=muted_foreground'
      switch dark  label=Dark  tag=dark
    scroll story  style='flex_1 overflow_y_scroll p=24'
    status-bar log
      text left  style='text_xs font_family=monospace text_color=muted_foreground truncate'
END
S=$r/main/story

# story name: set the heading and write the story's subtree.
# Each story is a directory in gallery/: title (heading and description),
# tree (the subtree document, which starts with the story node itself, so
# one write replaces the whole story), and files to write into the new
# nodes at the same relative paths. A .tsv file is written through tsv.
fn story {
	g=gallery/$1
	sed -n 1p $g/title >$r/main/head/t/title/text
	sed -n 2p $g/title >$r/main/head/t/desc/text
	cat $g/tree >$S/tree
	for(f in `{walk -f $g | sed 's,^'$g'/,,' | grep -v '^(title|tree)$'}){
		switch($f){
		case *.tsv
			tsv <$g/$f >$S/`{echo $f | sed 's/\.tsv$//'}
		case *
			cat $g/$f >$S/$f
		}
	}
}

# Overlays used by the stories. They are made once; stories only open them.
o=$w/overlays
echo 'new dialog dlg title=''Edit profile'' description=''Make changes to your profile here.'' width=420 keyboard=on
new alert-dialog del title=''Delete 3 files?'' description=''This cannot be undone.'' confirm=Delete cancel=Keep variant=danger tag=del
new sheet sheet side=right size=360 title=Filters
new popover pop anchor=root/main/story/v/p placement=bottom-start trigger=click
new hover-card card anchor=root/main/story/v/h' >$o/ctl
echo 'new input name placeholder=Name
new div footer style=''h_flex justify_end gap=8''' >$o/dlg/ctl
echo 'new button cancel label=Cancel style=ghost tag=dlg:cancel
new button save label=Save style=primary tag=dlg:save' >$o/dlg/footer/ctl
echo 'new checkbox a label=''Only open''
new checkbox b label=''Assigned to me''' >$o/sheet/ctl
echo 'new text t text=''A popover, opened by its anchor.'' style=p=12' >$o/pop/ctl
echo 'new div c style=''v_flex gap=4 p=12 w=240''' >$o/card/ctl
echo 'new text n text=''@gpuifs'' style=font_semibold
new text d text=''Files all the way down.'' style=text_sm' >$o/card/c/ctl

cur=button
story button

cat $k/events | while(ev=`{read}){
	echo $ev >$r/main/log/left/text
	t=`{attr tag}
	switch($ev(1)){
	case click
		switch($t){
		case story:*
			s=`{echo $t | sed 's/^story://'}
			echo off >$r/nav/*/$cur/active >[2]/dev/null
			echo on >$r/nav/*/$s/active
			cur=$s
			story $s
		case open:*
			echo open >$o/`{echo $t | sed 's/^open://'}^/ctl
		case dlg:*
			echo close >$o/dlg/ctl
			if(~ $t dlg:save) echo 'notify ''Profile saved'' type=success' >$w/ctl
		case toast:*
			y=`{echo $t | sed 's/^toast://'}
			echo 'notify ''This is '^$y^''' type='^$y >$w/ctl
		}
	case change
		if(~ $t dark){
			if(~ `{attr value} on) echo dark >$k/theme/mode
			if not echo light >$k/theme/mode
		}
	case confirm
		echo 'notify ''Deleted'' type=success' >$w/ctl
	case *
		stdquit
	}
}
