#!/bin/sh
# h9build: build an app directory into layers that h9 runs.
#
#   h9build [-o OUT] APPDIR
#
# Railpack detects the app and writes a plan, mise installs the runtimes the
# plan names, the plan's install and build commands run as written, and Wolfi
# packages make the roots. Every one of those steps runs inside h9; the host
# only needs h9, curl, tar, and a POSIX shell. The result is OUT/layers
# (runtime, deps, app), each an OCI layer that h9 wrote as an up layer, and
# OUT/run, which runs the app on h9 from them over the base root in the cache.
#
# Environment:
#   H9             the h9 binary (default: h9 on PATH)
#   H9_FLAGS       extra flags for every h9 run, such as --backend native
#   H9BUILD_CACHE  the cache (default: ${XDG_CACHE_HOME:-~/.cache}/h9build)
#   H9BUILD_BASE_PACKAGES  more Wolfi packages for the base root
#   H9BUILD_BUILD_PACKAGES more Wolfi packages for the builder root
#   H9BUILD_RAILPACK  a Railpack binary to use instead of the release
#   H9BUILD_MEMORY  guest memory for the build machines (default 4G)
#   H9BUILD_RUBY_COMPILE=1  build Ruby from source rather than use mise's precompiled one
#   H9BUILD_REPLAN=1  run Railpack's planner even if the source hasn't changed
#   HTTPS_PROXY, SSL_CERT_FILE  passed into the guest when set
set -eu

ALPINE_VERSION=3.22.2
RAILPACK_VERSION=0.43.0
WOLFI_REPO=https://packages.wolfi.dev/os
# The base root every app runs on, as Railpack's runtime image: glibc, its
# loader, the C++ runtime most prebuilt runtimes link against, OpenSSL and
# zlib, certificates, time zones, busybox for /bin/sh (start commands and npm
# scripts run through it), and bash, which some of mise's runtimes use for
# their wrappers (node's npm).
BASE_PACKAGES="wolfi-baselayout glibc ld-linux libgcc libstdc++ libssl3 zlib ca-certificates-bundle tzdata busybox bash ${H9BUILD_BASE_PACKAGES:-}"
# The builder adds what Railpack's builder image has for building: compilers
# and the usual headers, which runtimes mise builds from source and native
# packages (node-gyp, gems, cgo) need, and jq and git, which the guest
# scripts and package managers use.
BUILDER_PACKAGES="$BASE_PACKAGES jq git curl unzip zip xz rsync build-base cmake autoconf automake libtool pkgconf perl
	openssl-dev zlib-dev bzip2-dev xz-dev zstd-dev readline-dev sqlite-dev ncurses-dev libxml2-dev icu-dev libffi-dev yaml-dev gmp-dev
	${H9BUILD_BUILD_PACKAGES:-}"

usage() { echo "usage: h9build [-o OUT] APPDIR" >&2; exit 2; }
log() { echo "h9build: $*" >&2; }
die() { log "$*"; exit 1; }

out=
while getopts o: f; do
	case $f in
	o) out=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage
[ -d "$1" ] || die "$1: not a directory"
src=$(cd "$1" && pwd)
out=${out:-$PWD/$(basename "$src").h9}
here=$(cd "$(dirname "$0")" && pwd)
H9=${H9:-h9}
H9_FLAGS=${H9_FLAGS:-}
cache=${H9BUILD_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/h9build}
command -v "$H9" >/dev/null || die "no h9 (set H9)"

# h9 runs Linux programs for the host's own architecture.
case $(uname -m) in
x86_64 | amd64) arch=x86_64 rparch=x86_64 ;;
arm64 | aarch64) arch=aarch64 rparch=arm64 ;;
*) die "unsupported architecture $(uname -m)" ;;
esac

if command -v sha256sum >/dev/null; then sha256=sha256sum; else sha256='shasum -a 256'; fi
sha() { $sha256 | cut -c1-16; }

# h9 with the proxy settings, if any, passed in. The guest sees the CA bundle
# at /mnt/term/cwd/.ca.pem, so each run's cwd gets a copy.
h9run() {
	cwd=$1
	shift
	set -- --cwd "$cwd" "$@"
	if [ -n "${HTTPS_PROXY:-${https_proxy:-}}" ]; then
		p=${HTTPS_PROXY:-$https_proxy}
		set -- --env "HTTPS_PROXY=$p" --env "https_proxy=$p" "$@"
	fi
	if [ -n "${SSL_CERT_FILE:-}" ]; then
		cp "$SSL_CERT_FILE" "$cwd/.ca.pem"
		c=/mnt/term/cwd/.ca.pem
		set -- --env "SSL_CERT_FILE=$c" --env "NODE_EXTRA_CA_CERTS=$c" --env "GIT_SSL_CAINFO=$c" "$@"
	fi
	# shellcheck disable=SC2086
	"$H9" $H9_FLAGS "$@"
}

# fetch URL FILE: download once into the cache.
fetch() {
	[ -s "$2" ] && return 0
	log "fetching $1"
	mkdir -p "$(dirname "$2")"
	curl -fsSL -o "$2.tmp" "$1" && mv "$2.tmp" "$2"
}

# The bootstrap: Alpine's minirootfs, whose apk installs Wolfi packages into
# a root, and Railpack. Both are static or self-contained, so nothing here
# depends on the host's OS.
boot=$cache/bootstrap/alpine-$ALPINE_VERSION-$arch
if [ ! -d "$boot/etc" ]; then
	fetch "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VERSION%.*}/releases/$arch/alpine-minirootfs-$ALPINE_VERSION-$arch.tar.gz" "$cache/dl/alpine-$ALPINE_VERSION-$arch.tgz"
	mkdir -p "$boot.tmp"
	tar -xzf "$cache/dl/alpine-$ALPINE_VERSION-$arch.tgz" -C "$boot.tmp"
	mv "$boot.tmp" "$boot"
fi
mkdir -p "$boot/r"
fetch "$WOLFI_REPO/wolfi-signing.rsa.pub" "$cache/bootstrap/wolfi-signing.rsa.pub"
tools=$cache/tools
if [ ! -x "$tools/railpack" ]; then
	fetch "https://github.com/railwayapp/railpack/releases/download/v$RAILPACK_VERSION/railpack-v$RAILPACK_VERSION-$rparch-unknown-linux-musl.tar.gz" "$cache/dl/railpack-$RAILPACK_VERSION-$rparch.tgz"
	mkdir -p "$tools"
	tar -xzf "$cache/dl/railpack-$RAILPACK_VERSION-$rparch.tgz" -C "$tools" railpack
fi
railpack=$tools/railpack
if [ -n "${H9BUILD_RAILPACK:-}" ]; then
	[ -x "$H9BUILD_RAILPACK" ] || die "$H9BUILD_RAILPACK: not executable"
	railpack=$(cd "$(dirname "$H9BUILD_RAILPACK")" && pwd)/$(basename "$H9BUILD_RAILPACK")
fi

# root NAME PACKAGES...: a Wolfi root with those packages, made once per
# package set; prints its directory. apk writes it in place, as the up layer
# over an empty directory of the Alpine root.
root() {
	name=$1
	shift
	key=$(echo "$arch $WOLFI_REPO $*" | sha)
	dir=$cache/roots/$name-$key
	if [ ! -d "$dir/usr" ]; then
		log "making the $name root"
		work=$cache/roots/.work-$name-$key
		rm -rf "$work" "$dir.tmp"
		mkdir -p "$work" "$dir.tmp"
		cp "$cache/bootstrap/wolfi-signing.rsa.pub" "$here/guest/roots.sh" "$work/"
		h9run "$work" --dir "$boot:#L" --dir "$dir.tmp:#L/r:up" --net outbound \
			/bin/sh /mnt/term/cwd/roots.sh "$arch" "$WOLFI_REPO" "$@" >&2
		# apk's scripts can't run, so do busybox's install here: a link
		# for each applet that no package provides.
		for a in $(h9run "$work" --dir "$dir.tmp:#L" /usr/bin/busybox --list); do
			[ -e "$dir.tmp/usr/bin/$a" ] || [ -L "$dir.tmp/usr/bin/$a" ] || ln -s busybox "$dir.tmp/usr/bin/$a"
		done
		# /app, where the run starts, and mount points for the guest
		# scripts' trees: stack members rooted below the top need their
		# parent.
		mkdir -p "$dir.tmp/app" "$dir.tmp/h9build/src" "$dir.tmp/h9build/tools" "$dir.tmp/h9build/guest" "$dir.tmp/h9build/railpack"
		rm -rf "$work"
		mv "$dir.tmp" "$dir"
	fi
	echo "$dir"
}

# wolfi FILE: the Wolfi packages for the Debian packages FILE names, as
# alternatives for roots.sh: a name of our own for the common ones, else the
# Debian name, without its version or its lib prefix (libfoo-dev is often
# foo-dev in Wolfi).
wolfi() {
	while read -r p; do
		case $p in
		build-essential) echo build-base ;;
		pkg-config) echo pkgconf ;;
		libssl-dev) echo openssl-dev ;;
		zlib1g-dev) echo zlib-dev ;;
		zlib1g) echo zlib ;;
		libjemalloc2) echo jemalloc ;;
		libatomic1) echo libatomic ;;
		libyaml-0-2) echo yaml ;;
		libpq5) echo libpq ;;
		libpq-dev) echo 'libpq-dev|postgresql-dev' ;;
		libsqlite3-dev) echo sqlite-dev ;;
		libsqlite3-0) echo sqlite-libs ;;
		libvips-dev) echo vips-dev ;;
		libvips42 | libvips) echo vips ;;
		libmagickwand-dev) echo imagemagick-dev ;;
		default-libmysqlclient-dev) echo 'mariadb-connector-c-dev|mariadb-dev' ;;
		libncurses*-dev) echo ncurses-dev ;;
		*-dev)
			b=${p%-dev}
			echo "$p|${b#lib}-dev|$(echo "$b" | sed 's/[0-9.-]*$//')-dev|$(echo "${b#lib}" | sed 's/[0-9.-]*$//')-dev"
			;;
		*) echo "$p|$(echo "$p" | sed 's/[0-9.-]*$//')|$(echo "${p#lib}" | sed 's/[0-9.-]*$//')" ;;
		esac
	done <"$1"
}

builder=$(root builder $BUILDER_PACKAGES)

# The output. The layers and their keys stay between builds, so a layer
# whose inputs haven't changed is used again; the per-app caches stay too.
mkdir -p "$out/layers" "$out/cache"
rm -f "$out/env" "$out/run" "$out/layers.txt"
rm -rf "$out/layers"/*.tmp "$out/layers"/*.keep

# The source is at /h9build/src/NAME in the guest, under its own name, as
# Railpack names some things after the app's directory (a CMake binary).
name=$(basename "$src")
# Build machines get more memory than h9's default of 1 GB: compilers and
# package managers' parallel workers need it.
memory=${H9BUILD_MEMORY:-4G}
guest() {
	h9run "$out" --memory "$memory" --dir "$builder:#L" --dir "$tools:#L/h9build/tools" \
		--dir "$here/guest:#L/h9build/guest" --dir "$src:#L/h9build/src/$name" --env "H9BUILD_SRC=/h9build/src/$name" \
		--dir "$(dirname "$railpack"):#L/h9build/railpack" \
		--net outbound --env HOME=/root --env "H9BUILD_RAILPACK=/h9build/railpack/$(basename "$railpack")" \
		--env "H9BUILD_RUBY_COMPILE=${H9BUILD_RUBY_COMPILE:-}" "$@"
}

# The plan, and what plan.sh reads from it, are kept with a key: the
# source's files, Railpack, and plan.sh. Planning runs Railpack in a machine,
# which is most of a build with nothing changed, so it's skipped when the key
# matches. Railpack resolves versions when it plans, so a kept plan keeps the
# versions it resolved until the source changes; H9BUILD_REPLAN=1 plans again.
planfiles="plan.json steps.txt keys.txt shared.txt deploy.txt apt-build.txt apt-runtime.txt"
plankey=$(
	{
		echo "$arch $RAILPACK_VERSION"
		ls -lL "$railpack"
		$sha256 <"$here/guest/plan.sh"
		# shellcheck disable=SC2086
		(cd "$src" && find . -path "./$(basename "$out")" -prune -o -type f -exec $sha256 {} + | LC_ALL=C sort -k2)
	} | sha
)
planned=1
[ "${H9BUILD_REPLAN:-}" = 1 ] || [ "$(cat "$out/plan.key" 2>/dev/null)" != "$plankey" ] && planned=
for f in $planfiles; do [ -e "$out/$f" ] || planned=; done
if [ -n "$planned" ]; then
	log "plan: unchanged"
else
	(cd "$out" && rm -f plan.key $planfiles)
	log "planning"
	guest /bin/sh /h9build/guest/plan.sh
	echo "$plankey" >"$out/plan.key"
fi
# Railpack downloads the mise it pins on its first run; keep it for the next.
for m in "$out"/cache/mise-bin/mise-*; do
	[ -e "$m" ] || continue
	[ -e "$tools/$(basename "$m")" ] || mv "$m" "$tools/"
done

# The plan's apt packages, as Wolfi packages in the roots: the build ones in
# the builder, and the runtime ones in the base root the app runs on.
if [ -s "$out/apt-build.txt" ]; then
	log "build packages: $(tr '\n' ' ' <"$out/apt-build.txt")"
	# shellcheck disable=SC2046
	builder=$(root builder $BUILDER_PACKAGES $(wolfi "$out/apt-build.txt"))
fi
# shellcheck disable=SC2046
base=$(root base $BASE_PACKAGES $(wolfi "$out/apt-runtime.txt"))

# The layers, each built as the up layer over the builder root and the layers
# below it, from the plan's steps for it. Each is built in LAYER.tmp and
# moved into place when its steps succeed, so a failed step leaves no layer.
#
# The runtime layer is shared: it's built once into the cache, under a key of
# the builder root and the plan's runtime steps (shared.txt: its tools and
# their versions), and every app whose plan has the same steps uses it, so a
# runtime is installed once per machine rather than once per app. OUT/layers/
# runtime links to it. The files its steps copy from the source (a
# mise.toml) are app-specific, so they're taken out of the shared layer and
# made again in the deps layer.
read -r shared copies <"$out/shared.txt"
layerdir() { if [ "$1" = runtime ]; then echo "$cache/runtimes/$rkey"; else echo "$out/layers/$1"; fi; }
lower=
for l in runtime deps app; do
	if [ "$l" = runtime ]; then
		rkey=$(printf '%s %s %s %s\n' "$arch" "$(basename "$builder")" "$shared" "${H9BUILD_RUBY_COMPILE:-}" | sha)
		# The chain goes on from the app's own runtime key, which counts all
		# the files the runtime steps copy, as the deps layer makes them.
		key=$(printf '%s %s\n' "$rkey" "$(awk '$1 == "runtime" { print $2 }' "$out/keys.txt")" | sha)
		d=$(layerdir runtime)
		if [ -d "$d" ]; then
			log "layer runtime: shared, ${d#"$cache/"}"
		else
			t=$d.tmp.$$
			rm -rf "$t"
			mkdir -p "$t"
			if grep -q " runtime " "$out/steps.txt"; then
				log "layer runtime: building, to share as ${d#"$cache/"}"
				guest --dir "$t:#L:up" --tmp '#L/tmp' /bin/sh /h9build/guest/build.sh runtime
			fi
			rm -rf "$t/app"
			# Another build may have made it meanwhile; either is the same.
			if [ -d "$d" ]; then rm -rf "$t"; else mv "$t" "$d"; fi
		fi
		rm -rf "$out/layers/runtime" "$out/layers/runtime.key"
		ln -s "$d" "$out/layers/runtime"
	else
		key=$(printf '%s %s\n' "$key" "$(awk -v l="$l" '$1 == l { print $2 }' "$out/keys.txt")" | sha)
		d=$out/layers/$l
		if [ -d "$d" ] && [ "$(cat "$d.key" 2>/dev/null)" = "$key" ]; then
			log "layer $l: unchanged"
		else
			rm -rf "$d" "$d.key"
			mkdir -p "$d.tmp"
			if grep -q " $l " "$out/steps.txt" || { [ "$l" = deps ] && [ "$copies" = copies ]; }; then
				log "layer $l"
				# shellcheck disable=SC2086
				guest $lower --dir "$d.tmp:#L:up" --tmp '#L/tmp' /bin/sh /h9build/guest/build.sh "$l"
			fi
			mv "$d.tmp" "$d"
			echo "$key" >"$d.key"
		fi
	fi
	lower="$lower --dir $d:#L"
done
# shellcheck disable=SC2086
guest $lower --tmp '#L/tmp' /bin/sh /h9build/guest/build.sh env

# Prune the app layer to what the plan deploys from it: the paths it takes
# from the build, less their excludes. An exclude that a layer below holds is
# whited out, so it doesn't show through. The deps and runtime layers aren't
# pruned, as they're the next build's lowers.
a=$out/layers/app
k=$a.keep
mkdir -p "$k"
awk '$1 == "app" { print $2 }' "$out/deploy.txt" | sort -u | while read -r p; do
	[ -e "$a$p" ] || [ -L "$a$p" ] || continue
	mkdir -p "$k$(dirname "$p")"
	mv "$a$p" "$k$p"
done
awk '$1 == "app" { for (i = 3; i <= NF; i++) print $i }' "$out/deploy.txt" | sort -u | while read -r e; do
	# An exclude that another input takes is kept.
	awk -v e="$e" '$1 != "runtime" && ($2 == e || index($2, e "/") == 1) { f = 1 } END { exit !f }' "$out/deploy.txt" && continue
	rm -rf "$k$e"
	for l in deps runtime; do
		if [ -e "$out/layers/$l$e" ]; then
			mkdir -p "$k$(dirname "$e")"
			: >"$k$(dirname "$e")/.wh.$(basename "$e")"
			break
		fi
	done
done
rm -rf "$a"
mv "$k" "$a"

# The layers the run stacks, in order: each one that holds something the plan
# deploys. The runtime only when the plan deploys from a packages step (a Go
# binary doesn't need its toolchain), and deps when the plan deploys a path
# it holds (node_modules, a venv, gems), from it or from the build over it.
has() { # LAYER WHICH: whether LAYER holds a path the plan deploys from WHICH layers
	awk -v w="$2" '$1 ~ w { print $2 }' "$out/deploy.txt" | while read -r p; do
		if [ -e "$out/layers/$1$p" ]; then
			echo yes
			break
		fi
	done
}
{
	if [ -n "$(has runtime '^runtime$')" ]; then echo runtime; fi
	if [ -n "$(has deps '^(deps|app)$')" ]; then echo deps; fi
	if [ -n "$(ls -A "$a")" ]; then echo app; fi
} >"$out/layers.txt"

# OUT/run: the app on h9, from the layers, over the base root. The start
# command comes from the plan, in $H9BUILD_START; arguments replace it.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
{
	echo '#!/bin/sh'
	echo '# Generated by h9build: runs the app on h9 from its layers. Arguments replace the start command.'
	echo 'here=$(cd "$(dirname "$0")" && pwd)'
	echo '# shellcheck disable=SC2086'
	printf 'exec "${H9:-h9}" ${H9_FLAGS:-} --dir %s' "$(q "$base:#L")"
	while IFS= read -r l; do
		if [ "$l" = runtime ]; then printf ' --dir %s' "$(q "$(layerdir runtime):#L")"; else printf ' --dir "$here/layers/%s:#L"' "$l"; fi
	done <"$out/layers.txt"
	printf ' --net enable --env HOME=/root'
	while IFS= read -r kv; do printf ' --env %s' "$(q "$kv")"; done <"$out/env"
	printf ' /bin/sh -c %s sh "$@"\n' "$(q 'cd /app 2>/dev/null; if [ $# -gt 0 ]; then exec "$@"; fi; exec sh -c "$H9BUILD_START"')"
} >"$out/run"
chmod +x "$out/run"

log "done: $out (run it with $out/run)"
set -- "$base"
while IFS= read -r l; do set -- "$@" "$(layerdir "$l")"; done <"$out/layers.txt"
du -sh "$@" | sed "s|$cache|\$cache|; s|$out/||" >&2
